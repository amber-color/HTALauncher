<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=Edge">
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
<title>HTALauncher</title>
<HTA:APPLICATION
    ID="oHTA"
    APPLICATIONNAME="HTALauncher"
    BORDER="thin"
    BORDERSTYLE="normal"
    CAPTION="yes"
    MAXIMIZEBUTTON="no"
    MINIMIZEBUTTON="yes"
    SCROLL="no"
    SINGLEINSTANCE="yes"
    SYSMENU="yes"
    VERSION="1.0"
    WINDOWSTATE="normal"
/>
<style>
/* ===== リセット ===== */
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { width: 100%; height: 100%; overflow: hidden; font-family: 'c', 'BIZ UDPGothic', 'Segoe UI', Tahoma, sans-serif; font-size: 13px; }

/* ===== テーマ: ダーク ===== */
body.dark  { background: #1C1C1C; color: #D2D2D2; }
body.light { background: #F3F3F3; color: #1E1E1E; }

/* ===== ヘッダー (絶対配置) ===== */
#launcher { position: relative; width: 100%; height: 100%; }
#header   { position: absolute; top: 0;    left: 0; right: 0; height: 44px;
            display: -ms-flexbox; display: flex;
            -ms-flex-align: center; align-items: center; padding: 0 8px; }
body.dark  #header { background: #1C1C1C; }
body.light #header { background: #F3F3F3; }

#search-box { width: 1px; -ms-flex: 1 1 auto; flex: 1 1 auto; height: 26px; padding: 0 8px; font-family: inherit; margin-right: 4px; }
body.dark  #search-box { background: #3A3A3A; color: #D2D2D2; border: 1px solid #555; }
body.light #search-box { background: #FFF;    color: #1E1E1E; border: 1px solid #CCC; }
#search-box:focus { outline: none; }

.hbtn { width: 32px; height: 26px; border: none; font-size: 1.077em; cursor: pointer; padding: 0; margin-left: 3px; -ms-flex-negative: 0; flex-shrink: 0; }
body.dark  .hbtn { background: #3A3A3A; color: #D2D2D2; }
body.light .hbtn { background: #FFF;    color: #1E1E1E; }
body.dark  .hbtn:hover { background: #505050; }
body.light .hbtn:hover { background: #DEDEDE; }
.hbtn.active { background: #0078D7; color: #FFF; }

/* ===== タブパネル (絶対配置) ===== */
#tab-panel { position: absolute; top: 44px; left: 0; right: 0; height: 34px;
             overflow-x: auto; overflow-y: hidden; padding: 4px; }
body.dark  #tab-panel { background: #1C1C1C; }
body.light #tab-panel { background: #F3F3F3; }

.tbtn { height: 26px; padding: 0 10px; font-family: inherit; font-size: 0.923em; cursor: pointer; margin-right: 3px; border: none; border-bottom: 2px solid transparent; background: transparent; }
body.dark  .tbtn { color: #999; }
body.light .tbtn { color: #666; }
.tbtn.active { border-bottom-color: #0078D7; color: #0078D7; }

/* ===== コンテンツエリア (絶対配置・残り全高) ===== */
#content { position: absolute; top: 78px; left: 0; right: 0; bottom: 0; overflow-y: auto; overflow-x: auto; padding: 6px; -ms-overflow-style: -ms-autohiding-scrollbar; }
body.dark  #content { background: #1C1C1C; }
body.light #content { background: #F3F3F3; }

/* ===== グリッドビュー ===== */
/* gcell の width/height/gicon サイズは renderGrid で動的設定 */
.gcell { display: inline-block; margin: 2px; text-align: center; cursor: pointer; vertical-align: top; border-radius: 3px; }
body.dark  .gcell:hover { background: #373737; }
body.light .gcell:hover { background: #D0D0D0; }
.gcell.drag-over { background: #005A9E; }
.gcell.drag-src  { opacity: .45; }
body.dark  .gcell.kbd-sel { box-shadow: inset 0 0 0 2px #3399FF; }
body.light .gcell.kbd-sel { box-shadow: inset 0 0 0 2px #0056B3; }
body.dark  #list-tbl tr.kbd-sel td { background: #1E3A5F !important; }
body.light #list-tbl tr.kbd-sel td { background: #C5DCF5 !important; }

.gicon { margin: 4px auto 0;
         display: -ms-flexbox; display: flex;
         -ms-flex-align: center; align-items: center;
         -ms-flex-pack: center; justify-content: center;
         font-weight: bold; color: #FFF; border-radius: 6px; overflow: hidden; }
.gicon img { width: 100%; height: 100%; }

.glabel { font-size: 0.769em; text-align: center; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; width: 68px; margin: 3px auto 0; }
body.dark  .glabel { color: #D2D2D2; }
body.light .glabel { color: #1E1E1E; }

/* ===== リストビュー ===== */
#list-tbl { width: 100%; border-collapse: collapse; table-layout: fixed; }
#list-tbl tr { cursor: pointer; }
body.dark  #list-tbl tr:hover td { background: #373737; }
body.light #list-tbl tr:hover td { background: #D0D0D0; }
#list-tbl td { padding: 5px 8px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
body.dark  #list-tbl td { color: #D2D2D2; border-bottom: 1px solid #333; }
body.light #list-tbl td { color: #1E1E1E; border-bottom: 1px solid #DDD; }

.licon { display: -ms-inline-flexbox; display: inline-flex;
         -ms-flex-align: center; align-items: center;
         -ms-flex-pack: center; justify-content: center;
         width: 22px; height: 22px; font-size: 0.846em; font-weight: bold;
         color: #FFF; border-radius: 3px; margin-right: 6px; vertical-align: middle; }

/* ===== 設定オーバーレイ ===== */
#settings { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 10;
            display: none; -ms-flex-direction: column; flex-direction: column; font-size: inherit; }
#settings.open { display: -ms-flexbox; display: flex; }
body.dark  #settings { background: #1C1C1C; color: #D2D2D2; }
body.light #settings { background: #F3F3F3; color: #1E1E1E; }

.shead { height: 40px; display: -ms-flexbox; display: flex;
         -ms-flex-align: center; align-items: center;
         -ms-flex-pack: justify; justify-content: space-between;
         padding: 0 12px; -ms-flex-negative: 0; flex-shrink: 0; font-weight: bold; }
body.dark  .shead { background: #1C1C1C; }
body.light .shead { background: #F3F3F3; }

.stabs { display: -ms-flexbox; display: flex; -ms-flex-negative: 0; flex-shrink: 0; }
body.dark  .stabs { background: #1C1C1C; border-bottom: 1px solid #444; }
body.light .stabs { background: #F3F3F3; border-bottom: 1px solid #CCC; }

.stabtn { height: 32px; padding: 0 16px; border: none; border-bottom: 2px solid transparent;
          background: transparent; font-family: inherit; cursor: pointer; }
body.dark  .stabtn { color: #999; }
body.light .stabtn { color: #666; }
.stabtn.active { border-bottom-color: #0078D7; color: #0078D7; }

.scontent { -ms-flex: 1; flex: 1; min-height: 0; overflow-y: auto; padding: 12px; }
.stab { display: none; }
.stab.active { display: block; }

/* ===== 設定: アイテムリスト ===== */
.abtnrow { margin-bottom: 8px; }
.abtnrow .sbtn { margin-right: 5px; }

.sbtn { height: 28px; padding: 0 12px; font-family: inherit; font-size: 0.923em; cursor: pointer; border-radius: 2px; }
body.dark  .sbtn { background: #3A3A3A; color: #D2D2D2; border: 1px solid #555; }
body.light .sbtn { background: #F0F0F0; color: #1E1E1E; border: 1px solid #CCC; }
body.dark  .sbtn:hover { background: #505050; }
body.light .sbtn:hover { background: #E0E0E0; }
/* body 付きで書かないと body.dark/.light .sbtn に詳細度で負けて色が付かない */
body.dark  .sbtn.pri, body.light .sbtn.pri { background: #0078D7; color: #FFF; border-color: #0078D7; }
body.dark  .sbtn.pri:hover, body.light .sbtn.pri:hover { background: #006CBF; }

#app-tbl { width: 100%; border-collapse: collapse; table-layout: fixed;}
#app-tbl th { text-align: left; padding: 3px 8px; font-size: 0.846em; }
body.dark  #app-tbl th { color: #888; border-bottom: 1px solid #444; }
body.light #app-tbl th { color: #666; border-bottom: 1px solid #CCC; }
#app-tbl td { padding: 5px 8px; font-size: 0.923em; cursor: pointer; }
body.dark  #app-tbl td { color: #D2D2D2; border-bottom: 1px solid #333; }
body.light #app-tbl td { color: #1E1E1E; border-bottom: 1px solid #EEE; }
#app-tbl td.icon-col, #app-tbl th.icon-col { width: 36px; padding: 0 4px; }
#app-tbl tr.sel td { background: #0078D7; color: #FFF; }
body.dark  #app-tbl tr:not(.sel):hover td { background: #2A2A2A; }
body.light #app-tbl tr:not(.sel):hover td { background: #E8E8E8; }

/* ===== 設定: オプションフォーム ===== */
.cfg-inner { display: -ms-flexbox; display: flex; -ms-flex-direction: column; flex-direction: column;
             -ms-flex-align: center; align-items: center; padding-top: 16px; }
.srow { display: -ms-flexbox; display: flex; -ms-flex-align: center; align-items: center; margin-bottom: 14px; font-size: inherit; width: 340px; }
.slbl { width: 160px; font-size: inherit; -ms-flex-negative: 0; flex-shrink: 0; }
body.dark  .slbl { color: #CCC; }
body.light .slbl { color: #333; }
.srow select { -ms-flex: 1; flex: 1; height: 26px; padding: 0 6px; font-family: inherit; font-size: inherit; }
body.dark  .srow select { background: #3A3A3A; color: #D2D2D2; border: 1px solid #555; }
body.light .srow select { background: #FFF;    color: #1E1E1E; border: 1px solid #CCC; }
.srow input.skey { -ms-flex: 1; flex: 1; height: 26px; padding: 0 6px; font-family: inherit; font-size: inherit; text-align: center; cursor: pointer; }
body.dark  .srow input.skey { background: #3A3A3A; color: #D2D2D2; border: 1px solid #555; }
body.light .srow input.skey { background: #FFF;    color: #1E1E1E; border: 1px solid #CCC; }
body.dark  .srow input.skey:focus { border-color: #4A9EFF; }
body.light .srow input.skey:focus { border-color: #4A9EFF; }
.shint { -ms-flex: 1; flex: 1; font-size: 90%; }
body.dark  .shint { color: #999; }
body.light .shint { color: #777; }
/* body.dark .shint より詳細度を下げると勝てないので、こちらも body 付きで書く */
body.dark  .shint.err { color: #FF8A75; }
body.light .shint.err { color: #C0392B; }

/* ===== Windows アイコンピッカー ===== */
#iconpicker-ov { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 30;
                 display: none; -ms-flex-align: center; align-items: center;
                 -ms-flex-pack: center; justify-content: center; background: rgba(0,0,0,.7); }
#iconpicker-ov.open { display: -ms-flexbox; display: flex; }
#iconpicker-box { width: 520px; height: 460px; border-radius: 4px;
                  display: -ms-flexbox; display: flex;
                  -ms-flex-direction: column; flex-direction: column; }
body.dark  #iconpicker-box { background: #2D2D2D; border: 1px solid #555; }
body.light #iconpicker-box { background: #FFF;    border: 1px solid #CCC; }
.iph { height: 36px; display: -ms-flexbox; display: flex; -ms-flex-align: center; align-items: center;
       -ms-flex-pack: justify; justify-content: space-between; padding: 0 12px;
       -ms-flex-negative: 0; flex-shrink: 0; font-weight: bold; }
body.dark  .iph { background: #282828; color: #D2D2D2; }
body.light .iph { background: #E5E5E5; color: #1E1E1E; }
.ipc-search { display: -ms-flexbox; display: flex; padding: 8px 10px 6px;
              -ms-flex-align: center; align-items: center; -ms-flex-negative: 0; flex-shrink: 0; }
.ipc-search input { -ms-flex: 1; flex: 1; height: 26px; padding: 0 6px; font-family: inherit; margin-right: 6px; }
body.dark  .ipc-search input { background: #3A3A3A; color: #D2D2D2; border: 1px solid #555; }
body.light .ipc-search input { background: #FFF;    color: #1E1E1E; border: 1px solid #CCC; }
.ipc-search input:focus { outline: none; }
#ipc-status { padding: 2px 12px 4px; font-size: 0.923em; -ms-flex-negative: 0; flex-shrink: 0; min-height: 20px; }
body.dark  #ipc-status { color: #AAA; }
body.light #ipc-status { color: #666; }
#ipc-grid { -ms-flex: 1; flex: 1; overflow-y: auto; padding: 6px; }
/* ipcell は常に白背景: SVG の currentColor (黒) を見えるようにする */
.ipcell { display: inline-block; width: 44px; height: 44px; margin: 3px; cursor: pointer;
          border-radius: 3px; text-align: center; line-height: 44px; vertical-align: top;
          background: #F5F5F5; border: 1px solid transparent; }
.ipcell:hover   { background: #E0EEFF; border-color: #0078D7; }
.ipcell.selected { background: #CCE4FF; border-color: #0078D7; }
.ipcell img { width: 32px; height: 32px; vertical-align: middle; }

/* ===== アイテム追加/編集ダイアログ ===== */
#dlg-ov { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 20;
          display: none; -ms-flex-align: center; align-items: center;
          -ms-flex-pack: center; justify-content: center; background: rgba(0,0,0,.55); }
#dlg-ov.open { display: -ms-flexbox; display: flex; }

#dlg-box { width: 460px; padding: 20px; border-radius: 4px; }
body.dark  #dlg-box { background: #2D2D2D; border: 1px solid #555; }
body.light #dlg-box { background: #FFF;    border: 1px solid #CCC; }

.dlg-title { font-size: 1.077em; font-weight: bold; margin-bottom: 14px; }
body.dark  .dlg-title { color: #D2D2D2; }
body.light .dlg-title { color: #1E1E1E; }

.dlg-row { display: -ms-flexbox; display: flex; -ms-flex-align: center; align-items: center; margin-bottom: 10px; }
.dlg-lbl { width: 100px; font-size: 0.923em; -ms-flex-negative: 0; flex-shrink: 0; }
body.dark  .dlg-lbl { color: #CCC; }
body.light .dlg-lbl { color: #333; }

.dlg-inp { -ms-flex: 1; flex: 1; height: 26px; padding: 0 6px; font-family: inherit; }
body.dark  .dlg-inp { background: #3A3A3A; color: #D2D2D2; border: 1px solid #555; }
body.light .dlg-inp { background: #FFF;    color: #1E1E1E; border: 1px solid #CCC; }
.dlg-inp:focus { outline: none; }
body.dark  .dlg-inp:focus { border-color: #0078D7; }
body.light .dlg-inp:focus { border-color: #0078D7; }

.dlg-btns { display: -ms-flexbox; display: flex; -ms-flex-pack: end; justify-content: flex-end; margin-top: 14px; }
.dlg-btns .sbtn { margin-left: 8px; }

/* ===== メッセージ / 確認ダイアログ =====
   ネイティブの alert / confirm は画面中央に出てしまい、HTALauncher の窓と
   位置がずれる。同じ場所に出すため自前のモーダルに置き換えている。
   右クリックメニュー(1000)より手前に出す。 */
#msg-ov { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 2000;
          display: none; -ms-flex-align: center; align-items: center;
          -ms-flex-pack: center; justify-content: center;
          padding: 16px; background: rgba(0,0,0,.55); }
#msg-ov.open { display: -ms-flexbox; display: flex; }

#msg-box { max-width: 340px; padding: 18px 20px; border-radius: 4px; }
body.dark  #msg-box { background: #2D2D2D; border: 1px solid #555; }
body.light #msg-box { background: #FFF;    border: 1px solid #CCC; }

/* pre-wrap でメッセージ中の \n をそのまま改行として見せる */
#msg-text { white-space: pre-wrap; word-wrap: break-word; line-height: 1.5; }
body.dark  #msg-text { color: #D2D2D2; }
body.light #msg-text { color: #1E1E1E; }

/* 窓が狭いとボタンが並びきらないので折り返せるようにしておく */
#msg-btns { -ms-flex-wrap: wrap; flex-wrap: wrap; }
#msg-btns .sbtn { margin-top: 6px; }
</style>
</head>
<body class="dark">

<!-- ランチャー画面 -->
<div id="launcher">
  <div id="header">
    <input id="search-box" type="text" placeholder="検索...">
    <button class="hbtn" id="btn-grid" title="グリッド">▦</button>
    <button class="hbtn" id="btn-list" title="リスト">☰</button>
    <button class="hbtn" id="btn-gear" title="設定">⚙</button>
  </div>
  <div id="tab-panel"></div>
  <div id="content"></div>
</div>

<!-- 設定オーバーレイ -->
<div id="settings">
  <div class="shead">
    <span>設定</span>
    <button class="sbtn" id="btn-close-s">✕ 閉じる</button>
  </div>
  <div class="stabs">
    <button class="stabtn active" id="st-apps">登録一覧</button>
    <button class="stabtn"        id="st-act" >動作</button>
    <button class="stabtn"        id="st-look">外観</button>
  </div>
  <div class="scontent">

    <!-- 登録一覧タブ -->
    <div id="tab-apps" class="stab active">
      <div class="abtnrow">
        <button class="sbtn pri" id="s-add" >追加</button>
        <button class="sbtn"     id="s-edit">編集</button>
        <button class="sbtn"     id="s-del" >削除</button>
        <button class="sbtn"     id="s-up"  >↑</button>
        <button class="sbtn"     id="s-down">↓</button>
        <button class="sbtn"     id="s-claunch">CLaunch.ini取込</button>
      </div>
      <table id="app-tbl">
        <thead><tr>
          <th class="icon-col"></th>
          <th width="42%">表示名</th>
          <th>グループ</th>
          <th>パス</th>
        </tr></thead>
        <tbody id="app-tbody"></tbody>
      </table>
    </div>

    <!-- 動作タブ -->
    <div id="tab-act" class="stab">
      <div class="cfg-inner">
        <div class="srow">
          <span class="slbl">起動時のタブ</span>
          <select id="s-start-tab">
            <option value="all" >すべて</option>
            <option value="last">最後に開いていたタブ</option>
          </select>
        </div>
        <div class="srow">
          <span class="slbl">初期表示位置</span>
          <select id="s-position">
            <option value="topLeft">左上</option>
            <option value="topRight">右上</option>
            <option value="bottomLeft">左下</option>
            <option value="bottomRight">右下</option>
            <option value="center">中央</option>
          </select>
        </div>
        <div class="srow">
          <span class="slbl">アイテム選択後の動作</span>
          <select id="s-launch-action">
            <option value="minimize">最小化する</option>
            <option value="close">アプリを終了する</option>
            <option value="none">そのまま</option>
          </select>
        </div>
        <div class="srow">
          <span class="slbl">最前面表示</span>
          <select id="s-topmost">
            <option value="false">しない</option>
            <option value="true">する</option>
          </select>
        </div>
        <div class="srow">
          <span class="slbl">カーソル位置で起動</span>
          <select id="s-cursor-trigger">
            <option value="false">しない</option>
            <option value="true">する</option>
          </select>
        </div>
        <div class="srow">
          <span class="slbl">トリガー位置</span>
          <select id="s-cursor-position">
            <option value="topLeft">左上角</option>
            <option value="topRight">右上角</option>
            <option value="bottomLeft">左下角</option>
            <option value="bottomRight">右下角</option>
            <option value="top">上端</option>
            <option value="bottom">下端</option>
            <option value="left">左端</option>
            <option value="right">右端</option>
          </select>
        </div>
        <div class="srow">
          <span class="slbl">カーソルが外れたら最小化</span>
          <select id="s-auto-minimize">
            <option value="false">しない</option>
            <option value="true">する</option>
          </select>
        </div>
        <div class="srow">
          <span class="slbl">ショートカットで呼び出す</span>
          <select id="s-hotkey-enabled">
            <option value="false">しない</option>
            <option value="true">する</option>
          </select>
        </div>
        <div class="srow">
          <span class="slbl">ショートカットキー</span>
          <input type="text" id="s-hotkey-key" class="skey" readonly>
        </div>
        <div class="srow">
          <span class="slbl"></span>
          <span id="s-hotkey-msg" class="shint"></span>
        </div>
      </div>
    </div>

    <!-- 外観タブ -->
    <div id="tab-look" class="stab">
      <div class="cfg-inner">
        <div class="srow">
          <span class="slbl">テーマ</span>
          <select id="s-theme">
            <option value="dark" >ダーク</option>
            <option value="light">ライト</option>
          </select>
        </div>
        <div class="srow">
          <span class="slbl">文字サイズ</span>
          <select id="s-fontsize">
            <option value="small">小</option>
            <option value="medium">中</option>
            <option value="large">大</option>
          </select>
        </div>
        <div class="srow">
          <span class="slbl">既定のビュー</span>
          <select id="s-view">
            <option value="grid">グリッド</option>
            <option value="list">リスト</option>
          </select>
        </div>
        <div class="srow">
          <span class="slbl">グリッド：各セル幅 (px)</span>
          <select id="s-cellw">
            <option value="48">48</option>
            <option value="56">56</option>
            <option value="64">64</option>
            <option value="72">72</option>
            <option value="80">80</option>
            <option value="88">88</option>
            <option value="96">96</option>
            <option value="112">112</option>
          </select>
        </div>
        <div class="srow">
          <span class="slbl">グリッド：列数</span>
          <select id="s-cols"></select>
        </div>
        <div class="srow">
          <span class="slbl">グリッド：行数</span>
          <select id="s-rows"></select>
        </div>
        <div class="srow">
          <span class="slbl">リスト：行高 (px)</span>
          <select id="s-listheight"></select>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- アイテム追加/編集ダイアログ -->
<div id="dlg-ov">
  <div id="dlg-box">
    <div class="dlg-title" id="dlg-title">アイテム追加</div>
    <div class="dlg-row">
      <span class="dlg-lbl">表示名</span>
      <input class="dlg-inp" id="d-name"  type="text">
    </div>
    <div class="dlg-row">
      <span class="dlg-lbl">パス / URL</span>
      <input class="dlg-inp" id="d-path" type="text" style="margin-right:4px">
      <button class="sbtn" id="d-path-file"   style="-ms-flex-negative:0;flex-shrink:0">ファイル</button>
      <button class="sbtn" id="d-path-folder" style="-ms-flex-negative:0;flex-shrink:0;margin-left:4px">フォルダ</button>
    </div>
    <input type="file" id="path-file-picker" style="display:none">
    <input type="file" id="claunch-ini-picker" accept=".ini" style="display:none">
    <div class="dlg-row">
      <span class="dlg-lbl">グループ</span>
      <input class="dlg-inp" id="d-group" type="text">
    </div>
    <div class="dlg-row">
      <span class="dlg-lbl">アイコン画像</span>
      <input class="dlg-inp" id="d-icon" type="text" placeholder="省略可 (画像ファイルパス)" style="margin-right:4px">
      <button class="sbtn" id="d-icon-browse" style="-ms-flex-negative:0;flex-shrink:0">参照</button>
      <button class="sbtn" id="d-icon-win"    style="-ms-flex-negative:0;flex-shrink:0;margin-left:4px">Iconify</button>
    </div>
    <input type="file" id="icon-file-picker" accept=".ico,.png,.bmp,.jpg,.jpeg" style="display:none">
    <div class="dlg-btns">
      <button class="sbtn pri" id="d-ok"    >OK</button>
      <button class="sbtn"     id="d-cancel">キャンセル</button>
    </div>
  </div>
</div>

<!-- メッセージ / 確認ダイアログ（ボタンは showMsg() が組み立てる） -->
<div id="msg-ov">
  <div id="msg-box">
    <div id="msg-text"></div>
    <div class="dlg-btns" id="msg-btns"></div>
  </div>
</div>

<!-- Windows アイコンピッカー -->
<div id="iconpicker-ov">
  <div id="iconpicker-box">
    <div class="iph">
      <span>アイコン検索 (Iconify)</span>
      <button class="sbtn" id="ipc-close">&#x2715;</button>
    </div>
    <div class="ipc-search">
      <input id="ipc-q" type="text" placeholder="例: home, folder, chrome, github, star">
      <button class="sbtn pri" id="ipc-search-btn">検索</button>
    </div>
    <div id="ipc-status">キーワードを入力して検索してください</div>
    <div id="ipc-grid"></div>
  </div>
</div>

<!-- アイテム右クリックメニュー -->
<div id="context-menu" style="position: fixed; display: none; z-index: 1000; background: #FFF; border: 1px solid #CCC; box-shadow: 2px 2px 5px rgba(0,0,0,0.3);" onclick="event.stopPropagation()">
  <div id="menu-edit" style="padding: 8px 16px; cursor: pointer; border-bottom: 1px solid #EEE;"
    onmouseover="this.style.background='#0078D7';this.style.color='#FFF'"
    onmouseout="this.style.background='';this.style.color=''">編集</div>
  <div id="menu-delete" style="padding: 8px 16px; cursor: pointer;"
    onmouseover="this.style.background='#C0392B';this.style.color='#FFF'"
    onmouseout="this.style.background='';this.style.color=''">削除</div>
</div>

<!-- 余白右クリックメニュー -->
<div id="bg-context-menu" style="position: fixed; display: none; z-index: 1000; background: #FFF; border: 1px solid #CCC; box-shadow: 2px 2px 5px rgba(0,0,0,0.3);" onclick="event.stopPropagation()">
  <div id="menu-add" style="padding: 8px 16px; cursor: pointer;"
    onmouseover="this.style.background='#0078D7';this.style.color='#FFF'"
    onmouseout="this.style.background='';this.style.color=''">追加</div>
</div>

<script language="VBScript">
' ドロップ時にExplorerの選択アイテムのパスを取得する
' JScript側から GetDroppedPaths() として呼び出す
Function GetDroppedPaths()
    Dim shell, win, sel, i, result
    result = ""
    On Error Resume Next
    Set shell = CreateObject("Shell.Application")
    For Each win In shell.Windows()
        Set sel = win.Document.SelectedItems()
        If Err.Number = 0 And Not IsNull(sel) And sel.Count > 0 Then
            For i = 0 To sel.Count - 1
                If result <> "" Then result = result & Chr(10)
                result = result & sel.Item(i).Path
            Next
            If result <> "" Then Exit For
        End If
        Err.Clear
    Next
    On Error GoTo 0
    GetDroppedPaths = result
End Function

</script>

<script language="JScript">
// ===========================================================
// ファイル I/O（ADODB.Stream で UTF-8 対応）
// ===========================================================
var fso = new ActiveXObject("Scripting.FileSystemObject");
var wsh = new ActiveXObject("WScript.Shell");

function getDir() {
    var p = location.pathname.replace(/\//g, "\\");
    if (p.charAt(0) === "\\") { p = p.substring(1); }
    return fso.GetParentFolderName(p);
}
function getSelfPath() {
    var p = location.pathname.replace(/\//g, "\\");
    if (p.charAt(0) === "\\") { p = p.substring(1); }
    return p;
}
var DIR      = getDir();
var SELFPATH = getSelfPath();
var CFGPATH  = DIR + "\\config.json";
// 作業用ファイルはアプリのフォルダではなく %TEMP% に置いて、配布物や作業ツリーを汚さない
var TMPDIR = wsh.ExpandEnvironmentStrings("%TEMP%");
// ホットキー登録の成否を常駐 PowerShell から受け取るための一時ファイル
var HKSTATPATH = TMPDIR + "\\HTALauncherHotkey.status";
// モーダル表示中であることを常駐 PowerShell に伝えるための一時ファイル。
// これがある間は「カーソルが外れたら最小化」を抑止してもらう
var MODALFLAGPATH = TMPDIR + "\\HTALauncherModal.flag";

function readUtf8(path) {
    var st = new ActiveXObject("ADODB.Stream");
    st.Type    = 2;
    st.Charset = "UTF-8";
    st.Open();
    st.LoadFromFile(path);
    var s = st.ReadText();
    st.Close();
    if (s && s.charCodeAt(0) === 0xFEFF) { s = s.substring(1); }
    return s;
}

function writeUtf8(path, text) {
    var st = new ActiveXObject("ADODB.Stream");
    st.Type    = 2;
    st.Charset = "UTF-8";
    st.Open();
    st.WriteText(text);
    st.SaveToFile(path, 2);
    st.Close();
}

function readUnicode(path) {
    var st = new ActiveXObject("ADODB.Stream");
    st.Type    = 2;
    st.Charset = "unicode";
    st.Open();
    st.LoadFromFile(path);
    var s = st.ReadText();
    st.Close();
    if (s && s.charCodeAt(0) === 0xFEFF) { s = s.substring(1); }
    return s;
}

// ===========================================================
// ショートカットキー（グローバルホットキー）
// ===========================================================
// IE の keydown で得られる keyCode は Win32 の仮想キーコードと同じ値なので、
// 捕捉した keyCode をそのまま config に保存し、常駐 PowerShell の
// RegisterHotKey にも変換なしで渡せる。以下の表は表示用ラベルのためだけのもの。
var VK_NAMES = {
    8: "Backspace", 9: "Tab", 13: "Enter", 19: "Pause", 20: "CapsLock", 27: "Esc",
    32: "Space", 33: "PageUp", 34: "PageDown", 35: "End", 36: "Home",
    37: "←", 38: "↑", 39: "→", 40: "↓",
    45: "Insert", 46: "Delete",
    // テンキー
    96: "Num0", 97: "Num1", 98: "Num2", 99: "Num3", 100: "Num4", 101: "Num5",
    102: "Num6", 103: "Num7", 104: "Num8", 105: "Num9",
    106: "Num*", 107: "Num+", 109: "Num-", 110: "Num.", 111: "Num/",
    // 記号キー（JIS 配列の刻印に合わせている）
    186: ":", 187: ";", 188: ",", 189: "-", 190: ".", 191: "/",
    192: "@", 219: "[", 220: "\\", 221: "]", 222: "^", 226: "\\(ろ)"
};

function vkName(vk) {
    if (vk >= 48 && vk <= 57)  { return String.fromCharCode(vk); }          // 0-9
    if (vk >= 65 && vk <= 90)  { return String.fromCharCode(vk); }          // A-Z
    if (vk >= 112 && vk <= 123) { return "F" + (vk - 111); }                // F1-F12
    return VK_NAMES[vk] || ("VK" + vk);
}

function hotkeyLabel(hk) {
    var p = [];
    if (hk.ctrl)  { p.push("Ctrl"); }
    if (hk.alt)   { p.push("Alt"); }
    if (hk.shift) { p.push("Shift"); }
    p.push(vkName(hk.vk));
    return p.join(" + ");
}

// 既定は Ctrl+Alt+Space。Windows 標準のショートカットと衝突せず、
// ランチャーの呼び出しキーとしても一般的な組み合わせ。
// （Alt+Space 単体はウィンドウのシステムメニューに予約されているので使えない）
function defHotkey() {
    return { ctrl: true, alt: true, shift: false, vk: 32, label: "Ctrl + Alt + Space" };
}

// ===========================================================
// 設定読み込み
// ===========================================================
var cfg = (function() {
    var def = { apps: [], settings: { theme: "dark", defaultView: "grid",
                                      gridCellWidth: 72, gridCols: 5, gridRows: 6, windowPosition: "center", fontSize: "small", listRowHeight: 30,
                                      startTab: "all", lastTab: "すべて", launchAction: "minimize", topmost: false,
                                      cursorTriggerEnabled: false, cursorTriggerPosition: "bottomRight",
                                      autoMinimizeOnLeave: false,
                                      hotkeyEnabled: false, hotkey: defHotkey() } };
    try {
        if (fso.FileExists(CFGPATH)) {
            var c = JSON.parse(readUtf8(CFGPATH));
            if (!c.apps) { c.apps = []; }
            if (!c.settings) { c.settings = {}; }
            var s = c.settings;
            if (s.theme !== "dark" && s.theme !== "light") { s.theme = "dark"; }
            if (s.defaultView !== "grid" && s.defaultView !== "list") { s.defaultView = "grid"; }
            if (!s.gridCellWidth || s.gridCellWidth < 32)  { s.gridCellWidth = 72; }
            if (!s.gridCols      || s.gridCols < 2)        { s.gridCols = 5; }
            if (!s.gridRows      || s.gridRows < 2)        { s.gridRows = 6; }
            if (!s.windowPosition || ["topLeft", "topRight", "bottomLeft", "bottomRight", "center"].indexOf(s.windowPosition) < 0) { s.windowPosition = "center"; }
            if (!s.fontSize || ["small", "medium", "large"].indexOf(s.fontSize) < 0) { s.fontSize = "small"; }
            if (!s.listRowHeight || s.listRowHeight < 20) { s.listRowHeight = 30; }
            if (s.startTab !== "all" && s.startTab !== "last") { s.startTab = "all"; }
            if (!s.lastTab) { s.lastTab = "すべて"; }
            if (!s.launchAction || ["close", "minimize", "none"].indexOf(s.launchAction) < 0) { s.launchAction = "minimize"; }
            if (typeof s.topmost !== "boolean") { s.topmost = false; }
            if (typeof s.cursorTriggerEnabled !== "boolean") { s.cursorTriggerEnabled = false; }
            if (typeof s.autoMinimizeOnLeave !== "boolean") { s.autoMinimizeOnLeave = false; }
            if (!s.cursorTriggerPosition || ["topLeft", "topRight", "bottomLeft", "bottomRight", "top", "bottom", "left", "right"].indexOf(s.cursorTriggerPosition) < 0) { s.cursorTriggerPosition = "bottomRight"; }
            if (typeof s.hotkeyEnabled !== "boolean") { s.hotkeyEnabled = false; }
            // Ctrl と Alt がどちらも無い組み合わせは受け付けない。
            // 修飾なし（や Shift 単独）を登録すると、そのキーの通常入力を
            // システム全体から奪ってしまうため。
            if (!s.hotkey || typeof s.hotkey.vk !== "number" || s.hotkey.vk <= 0
                || (!s.hotkey.ctrl && !s.hotkey.alt)) {
                s.hotkey = defHotkey();
            } else {
                s.hotkey = { ctrl: !!s.hotkey.ctrl, alt: !!s.hotkey.alt, shift: !!s.hotkey.shift, vk: s.hotkey.vk };
                s.hotkey.label = hotkeyLabel(s.hotkey);
            }
            // tabPositions 旧フォーマット移行: {"group": {col,row}} → {col,row}
            for (var mi = 0; mi < c.apps.length; mi++) {
                var mtp = c.apps[mi].tabPositions;
                if (mtp && typeof mtp.col === "undefined") {
                    var mg = c.apps[mi].group;
                    c.apps[mi].tabPositions = (mg && mtp[mg]) ? mtp[mg] : undefined;
                }
            }
            return c;
        }
    } catch (e) {}
    return JSON.parse(JSON.stringify(def));
}());

function saveCfg() {
    cfg.settings.lastTab = curTab;
    try { writeUtf8(CFGPATH, JSON.stringify(cfg, null, 2)); } catch (e) {}
}

// ===========================================================
// 状態変数
// ===========================================================
var viewMode  = cfg.settings.defaultView;
var curTab    = (cfg.settings.startTab === "last" && cfg.settings.lastTab)
                ? cfg.settings.lastTab
                : "すべて";
var selIdx    = -1;
var dlgIdx    = -1;
var dragSrc   = -1;
var contextTargetIdx = -1;
var pendingDropPaths = []; // ondragenter で事前取得したパス一覧
var kbdIdx          = 0;   // キーボード選択中のフィルタ済みリスト上のインデックス
var kbdOrigI        = -1;  // 選択中アイテムの cfg.apps インデックス（絞り込み後も同アプリを追跡）
var kbdMoved        = false; // true のときのみ scrollIntoView を実行
var lastFilteredList = [];  // getFiltered() のキャッシュ（onkeydown で再計算しないため）
var preSearchTab    = null; // 検索前のタブ（検索クリア時に戻るため）
var kbdGridPos      = null; // 座標配置モードのカーソル位置 {col, row}
var lblH  = 0; // グリッドビューでのアイコン下のラベルの高さ

// ===========================================================
// 初期化
// ===========================================================
window.onload = function () {
    applyTheme(cfg.settings.theme);
    applyFontSize(cfg.settings.fontSize);

    // 列数・行数のドロップダウンを動的生成
    (function () {
        var cs = ge("s-cols"), rs = ge("s-rows");
        for (var n = 2; n <= 15; n++) {
            var o1 = document.createElement("option"); o1.value = String(n); o1.text = String(n); cs.appendChild(o1);
            if (n <= 12) {
                var o2 = document.createElement("option"); o2.value = String(n); o2.text = String(n); rs.appendChild(o2);
            }
        }
        var lh = ge("s-listheight");
        for (var n = 20; n <= 50; n += 5) {
            var o = document.createElement("option"); o.value = String(n); o.text = String(n); lh.appendChild(o);
        }
    }());

    resizeToGrid();

    // 検索（矢印キー・Enterはdocument.onkeydownで処理するためスキップ）
    ge("search-box").onkeyup = function (e) {
        var key = (e || window.event).keyCode;
        if (key >= 37 && key <= 40) { return; } // 矢印キー
        if (key === 13) { return; }              // Enter
        var q = this.value;
        if (q !== "" && curTab !== "\u3059\u3079\u3066") {
            // 検索開始：「すべて」へ移動してタブを記憶
            if (preSearchTab === null) { preSearchTab = curTab; }
            curTab = "\u3059\u3079\u3066";
            renderTabs();
        } else if (q === "" && preSearchTab !== null) {
            // 検索クリア：元のタブへ戻る
            curTab = preSearchTab;
            preSearchTab = null;
            kbdGridPos = null;
            renderTabs();
        }
        render();
    };

    // ヘッダーボタン
    ge("btn-grid").onclick = function () { setView("grid"); };
    ge("btn-list").onclick = function () { setView("list"); };
    ge("btn-gear").onclick = function () { openSettings(); };

    // 設定ボタン
    ge("btn-close-s").onclick = function () { closeSettings(); };
    ge("st-apps").onclick     = function () { switchTab("apps"); };
    ge("st-act").onclick      = function () { switchTab("act"); };
    ge("st-look").onclick     = function () { switchTab("look"); };
    ge("s-add").onclick       = function () { dlgOpen(-1); };
    ge("s-edit").onclick      = function () { dlgOpenSel(); };
    ge("s-del").onclick       = function () { appDel(); };
    ge("s-up").onclick        = function () { appMove(-1); };
    ge("s-down").onclick      = function () { appMove(1); };
    ge("s-claunch").onclick   = function () { claunchImportClick(); };
    ge("claunch-ini-picker").onchange = function () { claunchImportLoad(this); };

    // 動作タブ：変更即保存
    ge("s-start-tab").onchange    = function () { cfg.settings.startTab     = this.value; saveCfg(); };
    ge("s-position").onchange     = function () { cfg.settings.windowPosition = this.value; saveCfg(); positionToWindow(); };
    ge("s-launch-action").onchange = function () { cfg.settings.launchAction = this.value; saveCfg(); };
    ge("s-topmost").onchange      = function () {
        cfg.settings.topmost = (this.value === "true");
        saveCfg();
        applyTopmost(cfg.settings.topmost);
    };
    ge("s-cursor-trigger").onchange = function () {
        cfg.settings.cursorTriggerEnabled = (this.value === "true");
        saveCfg();
        if (cfg.settings.cursorTriggerEnabled) { startWatcher(); }
    };
    ge("s-cursor-position").onchange = function () {
        cfg.settings.cursorTriggerPosition = this.value;
        saveCfg();
    };
    ge("s-auto-minimize").onchange = function () {
        cfg.settings.autoMinimizeOnLeave = (this.value === "true");
        saveCfg();
        if (cfg.settings.autoMinimizeOnLeave) { startWatcher(); }
    };
    ge("s-hotkey-enabled").onchange = function () {
        cfg.settings.hotkeyEnabled = (this.value === "true");
        saveCfg();
        if (cfg.settings.hotkeyEnabled) { startWatcher(); }
        scheduleHotkeyStatus();
    };
    ge("s-hotkey-key").onfocus = function () {
        this.value = "キーを押してください…";
    };
    ge("s-hotkey-key").onblur = function () {
        this.value = cfg.settings.hotkey.label;
    };
    ge("s-hotkey-key").onkeydown = function (e) {
        var ev = e || window.event;
        var k  = ev.keyCode;

        // IE のアクセラレータ（Ctrl+F の検索など）が横取りしないよう、
        // keyCode を潰したうえで既定動作を止める。document.onkeydown 側にも
        // この入力欄を素通りさせるガードを入れてある。
        try { ev.keyCode = 0; } catch (eKc) {}
        ev.returnValue = false;
        if (ev.preventDefault) { ev.preventDefault(); }

        // 修飾キー単体は確定させない（押している途中なので）
        if (k === 16 || k === 17 || k === 18 || k === 91 || k === 92) { return false; }

        // Esc は取り消して元の値に戻す
        if (k === 27) {
            this.blur();
            return false;
        }

        // Ctrl も Alt も無い組み合わせを登録すると、そのキーの通常入力を
        // システム全体から奪ってしまう
        if (!ev.ctrlKey && !ev.altKey) {
            var msg = ge("s-hotkey-msg");
            msg.className = "shint err";
            msg.innerHTML = "Ctrl または Alt を含めてください。";
            return false;
        }

        var hk = { ctrl: !!ev.ctrlKey, alt: !!ev.altKey, shift: !!ev.shiftKey, vk: k };
        hk.label = hotkeyLabel(hk);
        cfg.settings.hotkey = hk;
        saveCfg();
        this.value = hk.label;
        this.blur();
        scheduleHotkeyStatus();
        return false;
    };

    // 外観タブ：変更即保存
    ge("s-theme").onchange    = function () { cfg.settings.theme       = this.value; saveCfg(); applyTheme(this.value); };
    ge("s-fontsize").onchange = function () { cfg.settings.fontSize    = this.value; saveCfg(); applyFontSize(this.value); };
    ge("s-view").onchange     = function () { cfg.settings.defaultView = this.value; saveCfg(); viewMode = this.value; updViewBtns(); render(); };
    ge("s-cellw").onchange    = function () { cfg.settings.gridCellWidth = parseInt(this.value, 10); saveCfg(); resizeToGrid(); render(); };
    ge("s-cols").onchange     = function () { cfg.settings.gridCols    = parseInt(this.value, 10); saveCfg(); resizeToGrid(); render(); };
    ge("s-rows").onchange     = function () { cfg.settings.gridRows    = parseInt(this.value, 10); saveCfg(); resizeToGrid(); render(); };
    ge("s-listheight").onchange = function () { cfg.settings.listRowHeight = parseInt(this.value, 10); saveCfg(); render(); };

    // ダイアログボタン
    ge("d-ok").onclick     = function () { dlgSave(); };
    ge("d-cancel").onclick = function () { dlgClose(); };

    // パス参照：ファイル（HTA完全信頼モードではinput.valueにフルパスが入る）
    ge("d-path-file").onclick = function () { ge("path-file-picker").click(); };
    ge("path-file-picker").onchange = function () {
        if (this.value) {
            ge("d-path").value = this.value;
            if (!ge("d-name").value) {
                var parts = this.value.replace(/[\\\/]+$/, "").split(/[\\\/]/);
                var base = parts[parts.length - 1] || "";
                ge("d-name").value = base.replace(/\.[^/.]+$/, "");
            }
        }
    };
    // パス参照：フォルダ（Shell.Application.BrowseForFolder）
    ge("d-path-folder").onclick = function () { browseForFolder(); };

    // アイコン参照ボタン
    ge("d-icon-browse").onclick = function () { ge("icon-file-picker").click(); };
    ge("icon-file-picker").onchange = function () {
        if (this.value) { ge("d-icon").value = this.value; }
    };

    // アイコンピッカー
    ge("d-icon-win").onclick      = function () { openIconPicker(); };
    ge("ipc-close").onclick       = function () { setOverlay("iconpicker-ov", false); };
    ge("ipc-search-btn").onclick  = function () { searchIcons(); };
    ge("ipc-q").onkeydown         = function (e) { if ((e || window.event).keyCode === 13) { searchIcons(); } };

    renderTabs();
    render();
    updViewBtns();
    positionToWindow();
    if (cfg.settings.topmost) { applyTopmost(true); }
    // 前回の異常終了でフラグが残っていると自動最小化が効かないままになる
    clearModalFlag();
    if (cfg.settings.cursorTriggerEnabled || cfg.settings.autoMinimizeOnLeave || cfg.settings.hotkeyEnabled) { startWatcher(); }

    // 右クリックメニュー
    ge("menu-edit").onclick = function () {
        ge("context-menu").style.display = "none";
        if (contextTargetIdx >= 0) {
            dlgOpen(contextTargetIdx);
        }
    };
    ge("menu-delete").onclick = function () {
        ge("context-menu").style.display = "none";
        if (contextTargetIdx < 0) { return; }
        // 応答を待つ間に contextTargetIdx が書き換わりうるので控えておく
        var delIdx = contextTargetIdx;
        msgConfirm('"' + cfg.apps[delIdx].name + '" を削除しますか？', function () {
            cfg.apps.splice(delIdx, 1);
            saveCfg();
            renderTabs();
            render();
        });
    };
    ge("menu-add").onclick = function () {
        ge("bg-context-menu").style.display = "none";
        dlgOpen(-1);
    };
    document.onclick = function () {
        ge("context-menu").style.display = "none";
        ge("bg-context-menu").style.display = "none";
    };
    // コンテンツ余白の右クリックで「追加」メニューを表示
    ge("content").oncontextmenu = function (e) {
        var ev = e || window.event;
        // アイテム上の右クリックは各セルのハンドラが処理するため伝播を止めてある
        // ここに到達したのは余白クリック
        ge("context-menu").style.display = "none";
        var menu = ge("bg-context-menu");
        menu.style.left = ev.clientX + "px";
        menu.style.top  = ev.clientY + "px";
        menu.style.display = "block";
        ev.preventDefault();
        return false;
    };

    // ドロップでアイテム追加
    // ondragenter: ドラッグがウィンドウに入った瞬間にExplorerの選択パスを取得
    // （ondrop 時点では選択状態がクリアされている場合があるため事前取得）
    document.body.ondragenter = function () {
        pendingDropPaths = [];
        try {
            var vbPaths = GetDroppedPaths();
            if (vbPaths) {
                var lines = vbPaths.split("\n");
                for (var i = 0; i < lines.length; i++) {
                    var p = lines[i].replace(/\r/g, "").trim();
                    if (p) pendingDropPaths.push(p);
                }
            }
        } catch (ex) {}
    };
    ge("content").ondragover = function (e) {
        e.preventDefault();
    };
    ge("content").ondrop = function (e) {
        if (!handleDropApp(e)) {
            // 既存アイコン上の内部ドラッグ並べ替えにも対応させるため、必要ならここで何もしない
        }
        e.stopPropagation(); // 重複登録防止
    };

    // 全体のドロップ対応（セルへのドロップも拾う）
    document.body.ondragover = function (e) {
        e.preventDefault();
    };
    document.body.ondrop = function (e) {
        handleDropApp(e);
    };

    // キーボードナビゲーション
    document.onkeydown = function (e) {
        var ev  = e || window.event;
        var key = ev.keyCode;

        // ショートカットキーの捕捉中は、どのキーも文書側で解釈しない。
        // 下の INPUT 除外だけでは Ctrl+F の処理のほうが先に走ってしまい、
        // Ctrl+F を登録しようとすると検索ボックスへフォーカスが飛んでしまう。
        var capTgt = ev.target || ev.srcElement;
        if (capTgt && capTgt.id === "s-hotkey-key") { return; }

        // メッセージ/確認モーダルが開いている間は、Esc でキャンセルする以外は
        // 何もしない（Tab と Enter はボタン側の既定動作に任せる）
        if (ge("msg-ov").className === "open") {
            if (key === 27) {
                msgClose(null);
                ev.returnValue = false;
                if (ev.preventDefault) { ev.preventDefault(); }
                return false;
            }
            return;
        }

        // Ctrl+F: 既定の「検索」ダイアログを出さず、検索ボックスにフォーカスする。
        // IE では preventDefault だけではブラウザ側のアクセラレータが動いてしまうため、
        // keyCode を 0 に潰す（IE で古くから使われている打ち消し方）。
        // モーダルより先に処理して、どの状態でも既定の検索が出ないようにする。
        if (key === 70 && ev.ctrlKey && !ev.altKey) {
            try { ev.keyCode = 0; } catch (eKc) {}
            ev.returnValue = false;
            if (ev.preventDefault) { ev.preventDefault(); }
            if (!isAnyModalOpen()) {
                var sbox = ge("search-box");
                if (sbox) {
                    sbox.focus();
                    if (sbox.select) { sbox.select(); }  // 既存の入力は選択状態にして上書きしやすくする
                }
            }
            return false;
        }

        if (isAnyModalOpen()) { return; }

        var tgt = ev.target || ev.srcElement;
        if (tgt && tgt.tagName === "INPUT"    && tgt.id !== "search-box") { return; }
        if (tgt && tgt.tagName === "TEXTAREA")                             { return; }

        // Ctrl+Tab / Ctrl+Shift+Tab でタブ切り替え
        if (key === 9 && ev.ctrlKey) {
            var groups = ["\u3059\u3079\u3066"], seen = {};
            for (var ti = 0; ti < cfg.apps.length; ti++) {
                var tg = cfg.apps[ti].group;
                if (tg && tg !== "" && !seen[tg]) { groups.push(tg); seen[tg] = 1; }
            }
            var idx = 0;
            for (var k = 0; k < groups.length; k++) { if (groups[k] === curTab) { idx = k; break; } }
            if (ev.shiftKey) {
                idx = (idx - 1 + groups.length) % groups.length;
            } else {
                idx = (idx + 1) % groups.length;
            }
            curTab = groups[idx];
            kbdGridPos = null;
            renderTabs();
            render();
            ev.preventDefault();
            return false;
        }

        var list = lastFilteredList;
        if (!list.length) { return; }

        if (key >= 37 && key <= 40) {
            if (viewMode === "grid" && curTab !== "\u3059\u3079\u3066") {
                // 座標配置モード: グリッド範囲内を上下左右移動
                if (kbdGridPos === null) { kbdGridPos = findNearestTopLeft(list); }
                var bounds = getGridBounds(list);
                var nc = kbdGridPos.col, nr = kbdGridPos.row;
                if      (key === 37) { nc--; }
                else if (key === 39) { nc++; }
                else if (key === 38) { nr--; }
                else if (key === 40) { nr++; }
                nc = Math.max(bounds.minCol, Math.min(bounds.maxCol, nc));
                nr = Math.max(bounds.minRow, Math.min(bounds.maxRow, nr));
                if (nc !== kbdGridPos.col || nr !== kbdGridPos.row) {
                    kbdGridPos = { col: nc, row: nr };
                    kbdMoved   = true;
                    render();
                }
            } else {
                var next = kbdIdx;
                if (viewMode === "grid") {
                    var cw   = cfg.settings.gridCellWidth || 72;
                    var ctEl = ge("content");
                    var cols = Math.max(1, Math.floor((ctEl.clientWidth || ctEl.offsetWidth || 400) / (cw + 4)));
                    if      (key === 37) { next -= 1; }
                    else if (key === 39) { next += 1; }
                    else if (key === 38) { next -= cols; }
                    else if (key === 40) { next += cols; }
                } else {
                    if      (key === 38) { next -= 1; }
                    else if (key === 40) { next += 1; }
                    else { return; }
                }
                next = Math.max(0, Math.min(next, list.length - 1));
                if (next !== kbdIdx) {
                    kbdIdx   = next;
                    kbdOrigI = list.length > 0 ? list[kbdIdx].i : -1;
                    kbdMoved = true;
                    render();
                }
            }
            ev.preventDefault();
            return false;
        }

        if (key === 13) {
            // 座標配置モードで空セル選択中は何もしない
            if (viewMode === "grid" && curTab !== "\u3059\u3079\u3066" && kbdIdx < 0) {
                ev.preventDefault();
                return false;
            }
            if (kbdIdx >= 0 && kbdIdx < list.length) {
                launch(list[kbdIdx].a);
            }
            ev.preventDefault();
            return false;
        }
    };

    // 起動時に検索ボックスにフォーカス
    ge("search-box").focus();
};

window.onbeforeunload = function () {
    try { saveCfg(); } catch (e) {}
    // 残したままだと自動最小化が効かなくなるので必ず消す
    clearModalFlag();
};

// ge() 省略形
function ge(id) { return document.getElementById(id); }

function isAnyModalOpen() {
    return ge("dlg-ov").className       === "open" ||
           ge("iconpicker-ov").className === "open" ||
           ge("settings").className      === "open" ||
           ge("msg-ov").className        === "open";
}

// ===========================================================
// モーダル表示中フラグ
// 追加/編集ダイアログや設定を開いている間は、参照ボタンやファイル選択で
// HTALauncher の枠の外を操作することがある。常駐ウォッチャーは HTA の中の
// モーダルを知りようがない（別ウィンドウではないので GetWindowRect では
// 判別できない）ため、開いている間だけ目印のファイルを置いて伝える。
// ===========================================================
var modalFlagOn = false;

// 入れ子でも正しく働くよう、開いた/閉じたを個別に渡さず
// isAnyModalOpen() から状態を作り直す
function syncModalFlag() {
    var on = isAnyModalOpen();
    if (on === modalFlagOn) { return; }
    modalFlagOn = on;
    try {
        if (on) { writeUtf8(MODALFLAGPATH, "1"); }
        else    { clearModalFlag(); }
    } catch (e) {}
}

function clearModalFlag() {
    modalFlagOn = false;
    try { if (fso.FileExists(MODALFLAGPATH)) { fso.DeleteFile(MODALFLAGPATH); } } catch (e) {}
}

// モーダルの表示/非表示は必ずここを通す。className を直接書き換えると
// フラグの更新を書き漏らし、最小化が止まらない/止まったままになるため。
function setOverlay(id, open) {
    ge(id).className = open ? "open" : "";
    syncModalFlag();
}

// ===========================================================
// メッセージ / 確認ダイアログ
// ネイティブの alert / confirm は HTALauncher の窓ではなく画面中央に出るため、
// 視線が飛んでしまう。見た目も位置も揃うよう自前のモーダルに置き換える。
// ネイティブと違い戻り値では返せないので、選択はコールバックで受け取る。
// ===========================================================
var msgPick      = null;   // 選択結果を渡すコールバック
var msgPrevFocus = null;   // モーダルを開く直前にフォーカスがあった要素

// buttons: [{ label: 表示名, value: コールバックに渡す値, pri: 既定ボタンなら true }, ...]
function showMsg(text, buttons, onPick) {
    ge("msg-text").textContent = text;
    var box = ge("msg-btns");
    box.innerHTML = "";
    var def = null;
    for (var i = 0; i < buttons.length; i++) {
        (function (b) {
            var btn = document.createElement("button");
            btn.className   = "sbtn" + (b.pri ? " pri" : "");
            btn.textContent = b.label;
            btn.onclick     = function () { msgClose(b.value); };
            box.appendChild(btn);
            if (b.pri) { def = btn; }
        }(buttons[i]));
    }
    msgPick = onPick || null;
    try { msgPrevFocus = document.activeElement; } catch (e) { msgPrevFocus = null; }
    setOverlay("msg-ov", true);
    // 既定ボタンにフォーカスを当てておくと、そのまま Enter で決定できる
    if (!def) { def = box.firstChild; }
    if (def) { def.focus(); }
}

// value が null のときはキャンセル扱いで、コールバックを呼ばずに閉じる
// （Esc で閉じた場合がこれにあたる）
function msgClose(value) {
    setOverlay("msg-ov", false);
    var cb = msgPick;
    msgPick = null;
    // 再描画でフォーカス先が消えていることがあるので保険をかける
    try { if (msgPrevFocus && msgPrevFocus.focus) { msgPrevFocus.focus(); } } catch (e) {}
    msgPrevFocus = null;
    if (cb && value !== null) { cb(value); }
}

function msgAlert(text) {
    showMsg(text, [{ label: "OK", value: true, pri: true }], null);
}

function msgConfirm(text, onYes) {
    showMsg(text,
            [{ label: "はい", value: true, pri: true }, { label: "いいえ", value: false }],
            function (v) { if (v) { onYes(); } });
}

// フォルダ選択ダイアログ（Shell.Application.BrowseForFolder）
function browseForFolder() {
    try {
        var shell = new ActiveXObject("Shell.Application");
        // 0x40 = BIF_NEWDIALOGSTYLE
        var item = shell.BrowseForFolder(0, "\u30d5\u30a9\u30eb\u30c0\u3092\u9078\u629e\u3057\u3066\u304f\u3060\u3055\u3044", 0x40);
        if (item) {
            var path = item.Self.Path;
            ge("d-path").value = path;
            if (!ge("d-name").value) {
                var parts = path.replace(/[\\]+$/, "").split("\\");
                ge("d-name").value = parts[parts.length - 1] || "";
            }
        }
    } catch (ex) {}
}

function handleDropApp(e, dropCol, dropRow) {
    if (!e || !e.dataTransfer) { return false; }
    e.stopPropagation();
    e.preventDefault();
    var prevLen = cfg.apps.length;
    var added = false;
    var dt = e.dataTransfer;

    var textData = "", urlData = "";
    try { textData = dt.getData("Text") || ""; } catch (ex) {}
    try { urlData  = dt.getData("URL")  || ""; } catch (ex) {}

    var localPaths = [];

    // 方法1: getText に Windowsパスが含まれる場合
    if (textData) {
        var lines = textData.split(/\r?\n/);
        for (var j = 0; j < lines.length; j++) {
            var line = lines[j].trim();
            if (/^[a-zA-Z]:\\/.test(line) || /^\\\\/.test(line)) {
                localPaths.push(line);
            }
        }
    }

    // 方法2: URL が file:/// 形式の場合はパスに変換
    if (localPaths.length === 0 && urlData && urlData.indexOf("file:///") === 0) {
        try {
            var absPath = decodeURIComponent(urlData.substr(8)).replace(/\//g, "\\");
            if (absPath) localPaths.push(absPath);
        } catch (ex) {}
    }

    // 方法3: ondragenter で事前取得したパスを使用（ファイル・フォルダ両対応）
    if (localPaths.length === 0 && pendingDropPaths.length > 0) {
        for (var k = 0; k < pendingDropPaths.length; k++) {
            localPaths.push(pendingDropPaths[k]);
        }
    }

    if (localPaths.length > 0) {
        var dropGroup = (curTab !== "\u3059\u3079\u3066") ? curTab : "";
        for (var i = 0; i < localPaths.length; i++) {
            var localPath = localPaths[i];
            var parts = localPath.replace(/[\\]+$/, "").split("\\");
            var baseName = parts[parts.length - 1] || "";
            var isFile = baseName.indexOf(".") !== -1;
            var appName = isFile ? baseName.replace(/\.[^/.]+$/, "") : baseName;
            if (!appName) appName = "（未設定）";
            cfg.apps.push({ name: appName, path: localPath, iconPath: "", group: dropGroup });
            added = true;
        }
    } else {
        // ローカルパスなし → URL(http/https)かチェック
        var rawUrl = (urlData || textData || "").replace(/^\s+|\s+$/g, "");
        var httpMatch = rawUrl.match(/^(https?:\/\/\S+)/);
        if (httpMatch) {
            // URLドロップ: タイトルをfetchして直接追加（ダイアログなし）
            var href = httpMatch[1];
            var dropGroup = (curTab !== "\u3059\u3079\u3066") ? curTab : "";
            // まずホスト名を仮の表示名にして即追加し、タイトルは通信を待たずに
            // 後から差し替える（同期取得だとここでアプリ全体が固まるため）
            var hostName = href.replace(/^https?:\/\//, "").split("/")[0];
            var newApp = { name: hostName, path: href, iconPath: "", group: dropGroup };
            cfg.apps.push(newApp);
            added = true;
            fetchPageTitleAsync(href, (function (a, provisional) {
                return function (title) {
                    if (!title || a.name !== provisional) { return; }
                    a.name = title;
                    saveCfg();
                    // ドラッグ中の再描画は操作を壊すので避ける（次の描画で反映される）
                    if (dragSrc < 0) { renderTabs(); render(); }
                };
            }(newApp, hostName)));
        } else {
            // URL以外: ファイルがある場合のみダイアログで補完（内部ドラッグは無視）
            var firstName = "";
            var hasFile = false;
            try {
                if (dt.files && dt.files.length > 0) {
                    hasFile = true;
                    firstName = (dt.files[0].name || "").replace(/\.[^/.]+$/, "");
                }
            } catch (ex) {}
            if (!hasFile) { return false; }
            dlgOpen(-1);
            if (firstName) { ge("d-name").value = firstName; }
            ge("d-path").focus();
            return false;
        }
    }

    if (added) {
        // 座標配置モードでのドロップ時、追加アイテムに位置を割り当て
        if (curTab !== "\u3059\u3079\u3066" && viewMode === "grid" && dropCol !== undefined) {
            var occ = {};
            for (var ok = 0; ok < prevLen; ok++) {
                var otp = cfg.apps[ok].tabPositions;
                if (otp && typeof otp.col !== "undefined" && cfg.apps[ok].group === curTab) {
                    occ[otp.col + "," + otp.row] = true;
                }
            }
            var dc = dropCol, dr = dropRow || 0;
            for (var ni = prevLen; ni < cfg.apps.length; ni++) {
                cfg.apps[ni].tabPositions = findFreePosNear(dc, dr, occ);
                dr++;
            }
        }
        saveCfg();
        renderTabs();
        render();
    }
    return added;
}

// ===========================================================
// テーマ
// ===========================================================
function applyTheme(t) {
    document.body.className = (t === "light") ? "light" : "dark";
}

function applyFontSize(fs) {
    var size;
    if (fs === "medium") size = "16px";
    else if (fs === "large") size = "19px";
    else size = "13px"; // small
    document.body.style.fontSize = size;
}

// ===========================================================
// タブ描画
// ===========================================================
function renderTabs() {
    var panel = ge("tab-panel");
    panel.innerHTML = "";
    var groups = ["\u3059\u3079\u3066"], seen = {};
    for (var i = 0; i < cfg.apps.length; i++) {
        var g = cfg.apps[i].group;
        if (g && g !== "" && !seen[g]) { groups.push(g); seen[g] = 1; }
    }
    if (!inArray(groups, curTab)) { curTab = "\u3059\u3079\u3066"; }

    for (var j = 0; j < groups.length; j++) {
        (function (gn) {
            var b = document.createElement("button");
            b.className   = "tbtn" + (gn === curTab ? " active" : "");
            b.textContent = gn;
            b.onclick = function () { curTab = gn; kbdGridPos = null; renderTabs(); render(); };
            panel.appendChild(b);
        }(groups[j]));
    }
}

function inArray(arr, val) {
    for (var k = 0; k < arr.length; k++) { if (arr[k] === val) { return true; } }
    return false;
}

// 全角英数→半角・全角スペース→半角・小文字化（あいまい検索用）
function normalize(s) {
    s = (s || "").toLowerCase();
    s = s.replace(/[\uFF01-\uFF5E]/g, function (c) { return String.fromCharCode(c.charCodeAt(0) - 0xFEE0); });
    s = s.replace(/\u3000/g, " ");
    return s;
}

// 選択セルが ct の可視範囲外のときだけ最小スクロール（autohiding スクロールバー誤発動防止）
function scrollCellIntoView(el, ct) {
    var er = el.getBoundingClientRect();
    var cr = ct.getBoundingClientRect();
    var sl = ct.scrollLeft, st = ct.scrollTop;
    var nsl = sl, nst = st;
    if (er.top    < cr.top)    { nst += er.top    - cr.top;    }
    if (er.bottom > cr.bottom) { nst += er.bottom - cr.bottom; }
    if (er.left   < cr.left)   { nsl += er.left   - cr.left;   }
    if (er.right  > cr.right)  { nsl += er.right  - cr.right;  }
    if (nst !== st) { ct.scrollTop  = nst; }
    if (nsl !== sl) { ct.scrollLeft = nsl; }
}

// 座標配置モード: リスト内で最も左上に近いアイテムの位置を返す
function findNearestTopLeft(list) {
    var best = null, bestScore = Infinity;
    for (var i = 0; i < list.length; i++) {
        var p = list[i].a.tabPositions;
        if (!p || typeof p.col === "undefined") { continue; }
        var score = p.row * 100000 + p.col;
        if (score < bestScore) { bestScore = score; best = { col: p.col, row: p.row }; }
    }
    return best || { col: 0, row: 0 };
}

// 指定座標にあるアイテムの listIdx を返す（なければ -1）
function findIdxAtPos(list, pos) {
    if (!pos) { return -1; }
    for (var i = 0; i < list.length; i++) {
        var p = list[i].a.tabPositions;
        if (p && p.col === pos.col && p.row === pos.row) { return i; }
    }
    return -1;
}

// アイテムが占める最小グリッド範囲を返す
function getGridBounds(list) {
    var minC = Infinity, maxC = 0, minR = Infinity, maxR = 0;
    for (var i = 0; i < list.length; i++) {
        var p = list[i].a.tabPositions;
        if (!p || typeof p.col === "undefined") { continue; }
        if (p.col < minC) { minC = p.col; }
        if (p.col > maxC) { maxC = p.col; }
        if (p.row < minR) { minR = p.row; }
        if (p.row > maxR) { maxR = p.row; }
    }
    if (minC === Infinity) { return { minCol: 0, maxCol: 0, minRow: 0, maxRow: 0 }; }
    return { minCol: minC, maxCol: maxC, minRow: minR, maxRow: maxR };
}

// 占有マップから空き座標を探す（先頭から順に左→右→次の行）。
// 指定された座標が空いていればそこを使い、埋まっていれば左上から走査する。
// 走査は設定の列数で折り返す。列数を超えて右へ伸ばすと表示範囲の外に
// 置かれてしまい、横スクロールしないと見えなくなるため。
function findFreePosNear(col, row, occ) {
    if (!occ[col + "," + row]) { occ[col + "," + row] = true; return { col: col, row: row }; }
    var cols = cfg.settings.gridCols || 5;
    if (cols < 1) { cols = 1; }
    for (var r = 0; ; r++) {
        for (var c = 0; c < cols; c++) {
            var k = c + "," + r;
            if (!occ[k]) { occ[k] = true; return { col: c, row: r }; }
        }
    }
}

// ===========================================================
// フィルター済みアイテム取得
// ===========================================================
function getFiltered() {
    var q = normalize(ge("search-box").value || "");
    var res = [];
    for (var i = 0; i < cfg.apps.length; i++) {
        var a = cfg.apps[i];
        if (curTab !== "\u3059\u3079\u3066" && a.group !== curTab) { continue; }
        if (q !== "") {
            var nm = normalize(a.name  || "");
            var gr = normalize(a.group || "");
            if (nm.indexOf(q) < 0 && gr.indexOf(q) < 0) { continue; }
        }
        res.push({ a: a, i: i });
    }
    return res;
}

// ===========================================================
// メイン描画
// ===========================================================
function render() {
    var ct   = ge("content");
    var list = getFiltered();
    lastFilteredList = list;

    // 座標配置モード: kbdGridPos からカーソルを解決
    if (curTab !== "\u3059\u3079\u3066" && viewMode === "grid") {
        if (kbdGridPos === null) {
            kbdGridPos = findNearestTopLeft(list);
        }
        kbdIdx   = findIdxAtPos(list, kbdGridPos);
        kbdOrigI = (kbdIdx >= 0) ? list[kbdIdx].i : -1;
    } else {
        // フローモード: 絞り込み後も同じアプリを選択し続ける
        if (list.length === 0) {
            kbdIdx = 0; kbdOrigI = -1;
        } else if (kbdOrigI >= 0) {
            var found = false;
            for (var fi = 0; fi < list.length; fi++) {
                if (list[fi].i === kbdOrigI) { kbdIdx = fi; found = true; break; }
            }
            if (!found) { kbdIdx = 0; kbdOrigI = list[0].i; }
        } else {
            kbdIdx = Math.max(0, Math.min(kbdIdx, list.length - 1));
            if (list.length > 0) { kbdOrigI = list[kbdIdx].i; }
        }
    }

    if (viewMode === "grid") { renderGrid(ct, list); }
    else                     { renderList(ct, list); }
    kbdMoved = false;
}

// ===========================================================
// アイコン
// ===========================================================
var COLORS = ["#0078D7","#E74856","#27B04E","#E8A000","#8764B8","#038387","#C43E1C","#107C10","#CA5010"];

function iconColor(name) {
    var h = 0;
    for (var i = 0; i < (name || "").length; i++) {
        h = ((h * 31) + (name || "").charCodeAt(i)) & 0xFFFF;
    }
    return COLORS[h % COLORS.length];
}

function initial(name) { return ((name || "?").charAt(0)).toUpperCase(); }

function faviconUrl(path) {
    var m = (path || "").match(/^https?:\/\/([^\/]+)/);
    if (!m) return null;
    // Google Favicon Service（より確実にファビコンを取得）
    return "https://www.google.com/s2/favicons?domain=" + m[1] + "&sz=48";
}

// URLのページタイトルを非同期で取得する（取得できない場合は done(null)）。
// 同期XHRだとページのHTMLを取り終わるまでアプリ全体が固まるため使わない。
function fetchPageTitleAsync(url, done) {
    var xhr = newHttp();
    var finished = false;
    function finish(v) { if (!finished) { finished = true; done(v); } }
    if (!xhr) { finish(null); return; }

    try {
        try { xhr.setTimeouts(5000, 5000, 5000, ICON_TIMEOUT_MS); } catch (eT) {}
        xhr.onreadystatechange = function () {
            if (xhr.readyState !== 4) { return; }
            try {
                if (xhr.status !== 200) { finish(null); return; }
                var m = xhr.responseText.match(/<title[^>]*>([\s\S]*?)<\/title>/i);
                if (m && m[1]) {
                    finish(m[1].replace(/\r?\n/g, " ").replace(/\s+/g, " ").replace(/^\s+|\s+$/g, ""));
                } else {
                    finish(null);
                }
            } catch (eIn) { finish(null); }
        };
        xhr.open("GET", url, true);
        xhr.send();
    } catch (eOut) { finish(null); return; }

    setTimeout(function () { finish(null); }, ICON_TIMEOUT_MS + 2000);
}

// ===========================================================
// アイコンピッカー（Iconify API）
// ===========================================================
function openIconPicker() {
    ge("ipc-q").value = "";
    ge("ipc-status").innerHTML = "\u30ad\u30fc\u30ef\u30fc\u30c9\u3092\u5165\u529b\u3057\u3066\u691c\u7d22\u3057\u3066\u304f\u3060\u3055\u3044";
    ge("ipc-grid").innerHTML   = "";
    setOverlay("iconpicker-ov", true);
    ge("ipc-q").focus();
}

function searchIcons() {
    var q = (ge("ipc-q").value || "").replace(/^\s+|\s+$/g, "");
    if (!q) { return; }
    ge("ipc-status").innerHTML = "\u691c\u7d22\u4e2d\u2026";
    ge("ipc-grid").innerHTML   = "";

    var url = "https://api.iconify.design/search?query=" + encodeURIComponent(q) + "&limit=999";
    var xhr;
    try { xhr = new XMLHttpRequest(); }        catch(e1) {
        try { xhr = new ActiveXObject("MSXML2.XMLHTTP.6.0"); } catch(e2) { xhr = null; }
    }
    if (!xhr) { ge("ipc-status").innerHTML = "XHR\u304c\u5229\u7528\u3067\u304d\u307e\u305b\u3093"; return; }

    xhr.onreadystatechange = function () {
        if (xhr.readyState !== 4) { return; }
        if (xhr.status !== 200) {
            ge("ipc-status").innerHTML = "\u691c\u7d22\u5931\u6557 (HTTP " + xhr.status + ")";
            return;
        }
        try {
            var data = JSON.parse(xhr.responseText);
            renderIconResults(data.icons || []);
        } catch (e) {
            ge("ipc-status").innerHTML = "\u30ec\u30b9\u30dd\u30f3\u30b9\u30a8\u30e9\u30fc: " + e.message;
        }
    };
    try { xhr.open("GET", url, true); xhr.send(); }
    catch (e) { ge("ipc-status").innerHTML = "\u901a\u4fe1\u30a8\u30e9\u30fc: " + e.message; }
}

function diversifyIcons(icons) {
    // アイコンセット（プレフィックス）ごとにグループ化してラウンドロビンで並び替え
    var groups = {}, prefixOrder = [];
    for (var i = 0; i < icons.length; i++) {
        var prefix = icons[i].split(":")[0];
        if (!groups[prefix]) { groups[prefix] = []; prefixOrder.push(prefix); }
        groups[prefix].push(icons[i]);
    }
    var result = [], idx = 0, hasMore = true;
    while (hasMore) {
        hasMore = false;
        for (var p = 0; p < prefixOrder.length; p++) {
            var g = groups[prefixOrder[p]];
            if (idx < g.length) {
                result.push(g[idx]);
                if (idx + 1 < g.length) { hasMore = true; }
            }
        }
        idx++;
    }
    return result;
}

function renderIconResults(icons) {
    var grid = ge("ipc-grid");
    grid.innerHTML = "";
    if (!icons.length) {
        ge("ipc-status").innerHTML = "\u7d50\u679c\u304c\u3042\u308a\u307e\u305b\u3093";
        return;
    }
    icons = diversifyIcons(icons);
    ge("ipc-status").innerHTML = icons.length + " \u4ef6";
    var cur = ge("d-icon").value;
    for (var i = 0; i < icons.length; i++) {
        (function (name) {
            var parts  = name.split(":");
            var prefix = parts[0], icon = parts[1];
            var imgUrl = "https://api.iconify.design/" + prefix + "/" + icon + ".svg?width=32&height=32";
            var saveUrl = "https://api.iconify.design/" + prefix + "/" + icon + ".svg?width=48&height=48";

            var cell = document.createElement("div");
            cell.className = "ipcell" + (saveUrl === cur ? " selected" : "");
            cell.title     = name;
            var img = document.createElement("img");
            img.src     = imgUrl;
            img.width   = 32;
            img.height  = 32;
            img.onerror = function () { if (cell.parentNode) { cell.parentNode.removeChild(cell); } };
            cell.appendChild(img);
            cell.onclick = function () {
                var prev = ge("ipc-grid").querySelector(".ipcell.selected");
                if (prev) { prev.className = "ipcell"; }
                cell.className = "ipcell selected";
                ge("d-icon").value = saveUrl;
                setOverlay("iconpicker-ov", false);
            };
            grid.appendChild(cell);
        }(icons[i]));
    }
}

function isRemoteUrl(u) { return /^https?:\/\//i.test(u || ""); }

// 「いますぐ描画に使える」アイコンの src（data URL かローカルパス）。無ければ null。
// リモート URL は決してここから返さない。img.src にリモート URL を入れると
// render() のたびにネットワークアクセスが発生し、通信が遅いときに
// ドラッグなどの UI 操作が引っかかるため。
function localIconSrc(app) {
    var p = app.iconPath || "";
    return (p && !isRemoteUrl(p)) ? p : null;
}

// このアイテムのアイコンとして取得すべきリモート URL。無ければ null。
// - iconPath がリモート URL（アイコンピッカーで選んだ直後や旧 config）
// - iconPath が空で path が http(s) → ファビコンサービス
function remoteIconUrl(app) {
    var p = app.iconPath || "";
    if (isRemoteUrl(p)) { return p; }
    if (!p) { return faviconUrl(app.path); }
    return null;
}

// 頭文字＋背景色のタイルとして描く（アイコン未取得・取得失敗時の表示）
function paintIconLetter(div, app, size) {
    div.textContent      = initial(app.name);
    div.style.background = iconColor(app.name);
    div.style.color      = "#FFF";
    div.style.fontWeight = "bold";
    div.style.fontSize   = Math.floor(size * 0.42) + "px";
}

// 画像として描く。読み込みに失敗したら頭文字タイルに戻す
function paintIconImage(div, src, app, size) {
    div.textContent      = "";
    div.style.background = "transparent";
    var img = document.createElement("img");
    img.style.width     = "100%";
    img.style.height    = "100%";
    img.style.objectFit = "contain";
    img.onerror = function () {
        if (img.parentNode) { img.parentNode.removeChild(img); }
        paintIconLetter(div, app, size);
    };
    img.src = src;
    div.appendChild(img);
}

function makeIconEl(app, size, radius) {
    var div = document.createElement("div");
    div.style.width          = size + "px";
    div.style.height         = size + "px";
    div.style.borderRadius   = radius || "5px";
    div.style.display        = "-ms-flexbox";
    div.style.msFlexAlign    = "center";
    div.style.msFlexPack     = "center";
    div.style.alignItems     = "center";
    div.style.justifyContent = "center";
    div.style.overflow       = "hidden";
    div.style.flexShrink     = "0";

    var src = localIconSrc(app);
    if (src) {
        paintIconImage(div, src, app, size);
    } else {
        // まだ手元に画像が無い: 頭文字タイルを即座に出しておき、
        // リモートから取るべきものがあれば取得キューに積む（描画はブロックしない）
        paintIconLetter(div, app, size);
        var rurl = remoteIconUrl(app);
        if (rurl) { queueIconFetch(app, rurl, div, size); }
    }
    return div;
}

// ===========================================================
// リモートアイコンの取得キュー
//
// 描画とネットワークを切り離すための仕組み。render() は検索の1文字ごとや
// タブ切替のたびに走るため、そこから直接リモート画像を読ませると未完了の
// リクエストが積み上がり、ドラッグなどの操作が引っかかる。そこで
//  - 同じ URL は 1 セッションにつき 1 回しか取りに行かない
//  - 同時実行は 1 件だけに直列化する
//  - 取得できたら data URL にして config.json に焼き込み、次回起動以降は通信しない
// ===========================================================
var ICON_TIMEOUT_MS = 10000;

var iconState   = {};    // url -> "pending" | "done" | "failed"
var iconWaiters = {};    // url -> [{ el, app, size }] 取得できたら差し替える要素
var iconQueue   = [];    // 未処理の url
var iconBusy    = false;
var _iconSaveTimer = null;

// WinHTTP ベースの ServerXMLHTTP を優先する。ファビコンサービス
// (www.google.com/s2/favicons) は t1.gstatic.com へ 301 リダイレクトするが、
// MSXML2.XMLHTTP は別ホストへのリダイレクトを "Access is denied" で拒否するため
// 取得できない。ServerXMLHTTP は追従する。
function newHttp() {
    try { return new ActiveXObject("MSXML2.ServerXMLHTTP.6.0"); } catch (e1) {}
    try { return new ActiveXObject("MSXML2.ServerXMLHTTP");     } catch (e2) {}
    try { return new ActiveXObject("MSXML2.XMLHTTP.6.0");       } catch (e3) {}
    return null;
}

function scheduleIconSave() {
    if (_iconSaveTimer) { clearTimeout(_iconSaveTimer); }
    _iconSaveTimer = setTimeout(function () {
        _iconSaveTimer = null;
        saveCfg();
    }, 1000);
}

function queueIconFetch(app, url, el, size) {
    var st = iconState[url];
    if (st === "failed") { return; }
    if (!iconWaiters[url]) { iconWaiters[url] = []; }
    iconWaiters[url].push({ el: el, app: app, size: size });
    if (st === "pending" || st === "done") { return; }
    iconState[url] = "pending";
    iconQueue.push(url);
    pumpIconQueue();
}

function pumpIconQueue() {
    if (iconBusy || iconQueue.length === 0) { return; }
    var url = iconQueue.shift();
    iconBusy = true;
    fetchBinaryAsync(url, function (dataUrl) {
        iconBusy = false;
        if (dataUrl) {
            onIconFetched(url, dataUrl);
        } else {
            iconState[url] = "failed";   // 次回起動時にまた試す（configには残さない）
            delete iconWaiters[url];
        }
        setTimeout(pumpIconQueue, 0);
    });
}

function onIconFetched(url, dataUrl) {
    iconState[url] = "done";

    // 同じ URL を使うアイテムすべてに反映する（まだ描画されていないものも含む）
    var hit = false;
    for (var i = 0; i < cfg.apps.length; i++) {
        if (remoteIconUrl(cfg.apps[i]) === url) { cfg.apps[i].iconPath = dataUrl; hit = true; }
    }
    if (hit) { scheduleIconSave(); }

    // 画面に出ている該当アイコンだけ差し替える。
    // ここで render() を呼ぶと、ドラッグ中だった場合に DOM が作り直されて
    // ドラッグ操作そのものが壊れるため、要素単位で更新する。
    var ws = iconWaiters[url] || [];
    for (var j = 0; j < ws.length; j++) {
        if (ws[j].el && ws[j].el.parentNode) {
            paintIconImage(ws[j].el, dataUrl, ws[j].app, ws[j].size);
        }
    }
    delete iconWaiters[url];
}

// バイナリを取得して data URL にする。失敗時は done(null)。
function fetchBinaryAsync(url, done) {
    var xhr = newHttp();
    var finished = false;
    function finish(v) { if (!finished) { finished = true; done(v); } }
    if (!xhr) { finish(null); return; }

    try {
        // 解決/接続/送信/受信のタイムアウト（ServerXMLHTTP のみ）
        try { xhr.setTimeouts(5000, 5000, 5000, ICON_TIMEOUT_MS); } catch (eT) {}
        xhr.onreadystatechange = function () {
            if (xhr.readyState !== 4) { return; }
            try {
                if (xhr.status !== 200) { finish(null); return; }
                finish(binaryToDataUrl(xhr, url));
            } catch (eIn) { finish(null); }
        };
        xhr.open("GET", url, true);
        xhr.send();
    } catch (eOut) { finish(null); return; }

    // setTimeouts が効かない実装のときの保険
    setTimeout(function () { finish(null); }, ICON_TIMEOUT_MS + 2000);
}

// バイト配列（responseBody 等）を base64 にする。
// ADODB.Stream で iso-8859-1 として読んで btoa() する方法は使えない。
// ADODB の "iso-8859-1" は実際には Windows-1252 として解釈され、
// バイト 0x80-0x9F が U+00FF を超える文字（€ や ' 等）に化けるため、
// btoa() が InvalidCharacterError を投げる。PNG では必ずこれを踏む
// （SVG のようにASCIIしか含まないデータだけ偶然通っていた）。
function bytesToBase64(bytes) {
    var dom = null;
    try { dom = new ActiveXObject("MSXML2.DOMDocument.6.0"); }
    catch (e1) { dom = new ActiveXObject("MSXML2.DOMDocument"); }
    var el = dom.createElement("b");
    el.dataType = "bin.base64";
    el.nodeTypedValue = bytes;
    return String(el.text).replace(/[\r\n]/g, "");
}

function binaryToDataUrl(xhr, url) {
    var ct = xhr.getResponseHeader("Content-Type") || "";
    var mime;
    if      (ct.indexOf("svg")  >= 0) { mime = "image/svg+xml"; }
    else if (ct.indexOf("png")  >= 0) { mime = "image/png"; }
    else if (ct.indexOf("gif")  >= 0) { mime = "image/gif"; }
    else if (ct.indexOf("jpeg") >= 0 || ct.indexOf("jpg") >= 0) { mime = "image/jpeg"; }
    else if (/\.svg(\?|$)/i.test(url))   { mime = "image/svg+xml"; }
    else if (/\.gif(\?|$)/i.test(url))   { mime = "image/gif"; }
    else if (/\.jpe?g(\?|$)/i.test(url)) { mime = "image/jpeg"; }
    else                                 { mime = "image/png"; }

    var b64 = bytesToBase64(xhr.responseBody);
    if (!b64) { return null; }
    return "data:" + mime + ";base64," + b64;
}

// ===========================================================
// グリッドビュー
// ===========================================================
function renderGrid(ct, list) {
    var savedSL = ct.scrollLeft;
    var savedST = ct.scrollTop;
    ct.innerHTML = "";
    var isAll = (curTab === "\u3059\u3079\u3066");
    var cw    = cfg.settings.gridCellWidth || 72;
    var iw    = Math.max(Math.floor(cw * 0.64), 20);
    var cellH = cw + lblH;
    var lblW  = cw - 2;

    if (!isAll) {
        // ======== 座標配置モード（「すべて」以外のタブ）========

        // 1. 占有マップ構築（既に位置を持つアイテム）
        var occupied = {};
        for (var pi = 0; pi < list.length; pi++) {
            var pa = list[pi].a;
            var pp = pa.tabPositions;
            if (pp && typeof pp.col !== "undefined") { occupied[pp.col + "," + pp.row] = true; }
        }

        // 2. 位置未割り当てのアイテムに自動割り当て
        var needSave = false;
        for (var ai = 0; ai < list.length; ai++) {
            var aa = list[ai].a;
            if (!aa.tabPositions || typeof aa.tabPositions.col === "undefined") {
                aa.tabPositions = findFreePosNear(0, 0, occupied);
                needSave = true;
            }
        }
        if (needSave) { saveCfg(); }

        // 3. コンテナサイズ計算
        var cols  = cfg.settings.gridCols || 5;
        var rows  = cfg.settings.gridRows || 6;
        var maxC = 0, maxR = 0;
        for (var si = 0; si < list.length; si++) {
            var sp = list[si].a.tabPositions;
            if (sp.col > maxC) { maxC = sp.col; }
            if (sp.row > maxR) { maxR = sp.row; }
        }
        // アイコンが設定グリッド内に収まる場合はグリッドサイズに合わせてスクロールバーを出さない。
        // はみ出す場合のみ余白 2 セル分を追加してスクロールを許可する。
        var innerW = ((maxC < cols) ? cols : (maxC + 2)) * (cw + 4);
        var innerH = ((maxR < rows) ? rows : (maxR + 2)) * (cellH + 4);
        // 4. 絶対配置の親コンテナ（サイズは内容だけで決定し、ct 幅に依存させない）
        var inner = document.createElement("div");
        inner.style.position = "relative";
        inner.style.width    = innerW + "px";
        inner.style.height   = innerH + "px";

        var kbdCell = null;
        for (var ci = 0; ci < list.length; ci++) {
            (function (item, listIdx) {
                var app = item.a, origI = item.i;
                var pos = app.tabPositions;

                var cell = document.createElement("div");
                cell.className      = "gcell" + (listIdx === kbdIdx ? " kbd-sel" : "");
                if (listIdx === kbdIdx) { kbdCell = cell; }
                cell.draggable      = true;
                cell.style.position = "absolute";
                cell.style.left     = (pos.col * (cw + 4)) + "px";
                cell.style.top      = (pos.row * (cellH + 4)) + "px";
                cell.style.width    = cw + "px";
                cell.style.height   = cellH + "px";

                var icon = makeIconEl(app, iw, "5px");
                icon.className = "gicon";
                icon.style.width  = iw + "px";
                icon.style.height = iw + "px";

                var lbl = document.createElement("div");
                lbl.className      = "glabel";
                lbl.textContent    = app.name;
                lbl.title          = app.name;
                lbl.style.width    = lblW + "px";
                lbl.style.fontSize = Math.max(Math.floor(cw * 0.15), 9) + "px";

                cell.appendChild(icon);
                cell.appendChild(lbl);

                cell.onclick = (function (a) { return function () { launch(a); }; }(app));

                cell.oncontextmenu = (function (idx) {
                    return function (e) {
                        var ev = e || window.event;
                        ev.preventDefault();
                        if (ev.stopPropagation) { ev.stopPropagation(); }
                        ge("bg-context-menu").style.display = "none";
                        contextTargetIdx = idx;
                        var menu = ge("context-menu");
                        menu.style.left = ev.clientX + "px";
                        menu.style.top  = ev.clientY + "px";
                        menu.style.display = "block";
                        return false;
                    };
                }(origI));

                // ドラッグ開始
                cell.ondragstart = (function (idx, c) {
                    return function (e) {
                        dragSrc = idx;
                        e.dataTransfer.effectAllowed = "move";
                        e.dataTransfer.setData("Text", String(idx));
                        setTimeout(function () { c.className = "gcell drag-src"; }, 0);
                    };
                }(origI, cell));

                cell.ondragend = (function (c) {
                    return function () { dragSrc = -1; c.className = "gcell"; };
                }(cell));

                // セル上のドラッグオーバーは許可のみ（ドロップは inner で処理）
                cell.ondragover = function (e) { e.preventDefault(); };

                inner.appendChild(cell);
            }(list[ci], ci));
        }

        // 5. 内部コンテナへのドロップ（外部ファイル or 内部位置変更）
        inner.ondragover = function (e) { e.preventDefault(); };
        inner.ondrop = function (e) {
            e.preventDefault();
            e.stopPropagation();

            var rect  = inner.getBoundingClientRect();
            var mx    = e.clientX - rect.left;
            var my    = e.clientY - rect.top;
            var tCol  = Math.max(0, Math.floor(mx / (cw + 4)));
            var tRow  = Math.max(0, Math.floor(my / (cellH + 4)));

            // 外部ドロップ（ファイル/URL）: 座標付きで処理
            if (handleDropApp(e, tCol, tRow)) { dragSrc = -1; return; }

            // 内部ドラッグ: 座標変更
            if (dragSrc < 0) { return; }
            var srcApp = cfg.apps[dragSrc];
            if (!srcApp || srcApp.group !== curTab) { dragSrc = -1; return; }
            var srcPos = srcApp.tabPositions;
            if (!srcPos || typeof srcPos.col === "undefined") { dragSrc = -1; return; }
            if (srcPos.col === tCol && srcPos.row === tRow) { dragSrc = -1; return; }

            // 移動先に別アイテムがあればスワップ
            var occ2 = {};
            for (var k = 0; k < cfg.apps.length; k++) {
                if (cfg.apps[k] === srcApp) { continue; }
                var tp = cfg.apps[k].tabPositions;
                if (tp && typeof tp.col !== "undefined" && cfg.apps[k].group === curTab) {
                    occ2[tp.col + "," + tp.row] = k;
                }
            }
            var tKey = tCol + "," + tRow;
            if (occ2.hasOwnProperty(tKey)) {
                cfg.apps[occ2[tKey]].tabPositions = { col: srcPos.col, row: srcPos.row };
            }
            srcPos.col = tCol;
            srcPos.row = tRow;

            dragSrc = -1;
            saveCfg();
            render();
        };

        // 空セルにカーソルがある場合はゴースト枠を描画
        var ghostCell = null;
        if (kbdGridPos !== null && kbdIdx < 0) {
            var ghost = document.createElement("div");
            ghost.className      = "gcell kbd-sel";
            ghost.style.position = "absolute";
            ghost.style.left     = (kbdGridPos.col * (cw + 4)) + "px";
            ghost.style.top      = (kbdGridPos.row * (cellH + 4)) + "px";
            ghost.style.width    = cw + "px";
            ghost.style.height   = cellH + "px";
            inner.appendChild(ghost);
            ghostCell = ghost;
        }

        ct.appendChild(inner);
        ct.scrollLeft = savedSL;
        ct.scrollTop  = savedST;
        if (kbdMoved && kbdCell)  { scrollCellIntoView(kbdCell,  ct); }
        if (kbdMoved && ghostCell) { scrollCellIntoView(ghostCell, ct); }
        return;
    }

    // ======== フロー配置モード（「すべて」タブ）========
    var kbdCell = null;
    for (var i = 0; i < list.length; i++) {
        (function (item, listIdx) {
            var app = item.a, origI = item.i;

            var cell = document.createElement("div");
            cell.className    = "gcell" + (listIdx === kbdIdx ? " kbd-sel" : "");
            if (listIdx === kbdIdx) { kbdCell = cell; }
            cell.draggable    = true;
            cell.style.width  = cw    + "px";
            cell.style.height = cellH + "px";

            var icon = makeIconEl(app, iw, "5px");
            icon.className    = "gicon";
            icon.style.width  = iw + "px";
            icon.style.height = iw + "px";

            var lbl = document.createElement("div");
            lbl.className      = "glabel";
            lbl.textContent    = app.name;
            lbl.title          = app.name;
            lbl.style.width    = lblW + "px";
            lbl.style.fontSize = Math.max(Math.floor(cw * 0.15), 9) + "px";

            cell.appendChild(icon);
            cell.appendChild(lbl);

            cell.onclick = (function (a) { return function () { launch(a); }; }(app));

            cell.oncontextmenu = (function (idx) {
                return function (e) {
                    var ev = e || window.event;
                    ev.preventDefault();
                    if (ev.stopPropagation) ev.stopPropagation();
                    ge("bg-context-menu").style.display = "none";
                    contextTargetIdx = idx;
                    var menu = ge("context-menu");
                    menu.style.left = ev.clientX + "px";
                    menu.style.top = ev.clientY + "px";
                    menu.style.display = "block";
                    return false;
                };
            }(origI));

            cell.ondragstart = (function (idx, c) {
                return function (e) {
                    dragSrc = idx;
                    e.dataTransfer.effectAllowed = "move";
                    e.dataTransfer.setData("Text", String(idx));
                    c.className = "gcell drag-src";
                };
            }(origI, cell));

            cell.ondragend = (function (c) {
                return function () { dragSrc = -1; c.className = "gcell"; };
            }(cell));

            cell.ondragover = (function (idx, c) {
                return function (e) {
                    e.preventDefault();
                    if (dragSrc !== idx) { c.className = "gcell drag-over"; }
                };
            }(origI, cell));

            cell.ondragleave = (function (c) {
                return function () { c.className = "gcell"; };
            }(cell));

            cell.ondrop = (function (tgtIdx, tgtApp, c) {
                return function (e) {
                    e.preventDefault();
                    c.className = "gcell";

                    if (handleDropApp(e)) {
                        dragSrc = -1;
                        e.stopPropagation();
                        return;
                    }

                    // \u78ba\u8a8d\u306e\u5fdc\u7b54\u3092\u5f85\u3064\u9593\u30c9\u30e9\u30c3\u30b0\u72b6\u614b\u3092\u6301\u3061\u8d8a\u3055\u306a\u3044\u3088\u3046\u3001\u5148\u306b\u7247\u4ed8\u3051\u308b
                    var src = dragSrc;
                    dragSrc = -1;
                    if (src < 0 || src === tgtIdx) { return; }
                    var srcName = cfg.apps[src] ? cfg.apps[src].name : "?";
                    msgConfirm('"' + srcName + '" \u3092 "' + tgtApp.name + '" \u306e\u524d\u306b\u79fb\u52d5\u3057\u307e\u3059\u304b\uff1f', function () {
                        var moved = cfg.apps.splice(src, 1)[0];
                        var ni = -1;
                        for (var k = 0; k < cfg.apps.length; k++) {
                            if (cfg.apps[k] === tgtApp) { ni = k; break; }
                        }
                        if (ni < 0) { ni = cfg.apps.length; }
                        cfg.apps.splice(ni, 0, moved);
                        saveCfg();
                        renderTabs();
                        render();
                    });
                };
            }(origI, app, cell));

            ct.appendChild(cell);
        }(list[i], i));
    }
    if (kbdMoved && kbdCell) { kbdCell.scrollIntoView(false); }
}

// ===========================================================
// リストビュー
// ===========================================================
function renderList(ct, list) {
    ct.innerHTML = "";
    var tbl = document.createElement("table");
    tbl.id = "list-tbl";

    // 列幅固定（table-layout:fixed と組み合わせて overflow ellipsis を有効化）
    var cg = document.createElement("colgroup");
    var c2 = document.createElement("col"); c2.style.width = "30%";
    var c3 = document.createElement("col"); c3.style.width = "10%";
    cg.appendChild(document.createElement("col")); // 列1: 残り全幅
    cg.appendChild(c2);
    cg.appendChild(c3);
    tbl.appendChild(cg);

    var kbdRow = null;
    for (var i = 0; i < list.length; i++) {
        (function (item, listIdx) {
            var app = item.a;
            var tr  = document.createElement("tr");
            tr.style.height = cfg.settings.listRowHeight + "px";
            if (listIdx === kbdIdx) { tr.className = "kbd-sel"; kbdRow = tr; }
            tr.onclick = (function (a) { return function () { launch(a); }; }(app));
            tr.oncontextmenu = (function (idx) {
                return function (e) {
                    var ev = e || window.event;
                    ev.preventDefault();
                    if (ev.stopPropagation) ev.stopPropagation();
                    ge("bg-context-menu").style.display = "none";
                    contextTargetIdx = idx;
                    var menu = ge("context-menu");
                    menu.style.left = ev.clientX + "px";
                    menu.style.top = ev.clientY + "px";
                    menu.style.display = "block";
                    return false;
                };
            }(item.i));

            // 列1: アイコン + 名前
            var td1 = document.createElement("td");
            td1.style.whiteSpace = "nowrap";
            var ic = makeIconEl(app, 22, "3px");
            ic.className       = "licon";
            ic.style.display   = "-ms-inline-flexbox";
            td1.appendChild(ic);
            td1.appendChild(document.createTextNode(app.name));

            // 列2: グループ
            var td2 = document.createElement("td");
            td2.textContent = app.group || "";
            td2.style.width = "100px";

            // 列3: パス
            var td3 = document.createElement("td");
            td3.textContent    = app.path || "";
            td3.style.color    = "#888";
            td3.style.fontSize = "11px";

            tr.appendChild(td1);
            tr.appendChild(td2);
            tr.appendChild(td3);
            tbl.appendChild(tr);
        }(list[i], i));
    }
    ct.appendChild(tbl);
    if (kbdMoved && kbdRow) { kbdRow.scrollIntoView(false); }
}

// ===========================================================
// アイテム起動
// ===========================================================
function launch(app) {
    if (!app.path) { return; }
    var action = (cfg.settings && cfg.settings.launchAction) || "minimize";
    try {
        var cmd = (app.path.match(/^https?:\/\//)) ? app.path : '"' + app.path + '"';
        if (action === "minimize") {
            // 先に最小化してからアプリ起動することで、アプリが前面に表示される
            try {
                wsh.AppActivate(document.title);
                wsh.SendKeys("% n");
            } catch (e) {}
            wsh.Run(cmd, 1, false);
        } else {
            wsh.Run(cmd, 1, false);
            if (action === "close") { window.close(); }
        }
    } catch (e) {
        // "minimize" \u306e\u3068\u304d\u306f\u65e2\u306b\u7a93\u3092\u5f15\u3063\u8fbc\u3081\u305f\u5f8c\u306a\u306e\u3067\u3001\u305d\u306e\u307e\u307e\u3067\u306f
        // \u30e2\u30fc\u30c0\u30eb\u304c\u898b\u3048\u306a\u3044\u3002\u5fa9\u5e30\u3055\u305b\u3066\u304b\u3089\u51fa\u3059
        if (action === "minimize") { restoreWindow(); }
        // ActiveX \u7531\u6765\u306e\u4f8b\u5916\u306f message \u304c\u7a7a\u3067 description \u5074\u306b\u5165\u308b\u3053\u3068\u304c\u3042\u308b\u3002
        // \u3069\u3061\u3089\u3082\u7121\u3051\u308c\u3070\u7a7a\u884c\u3060\u3051\u304c\u6b8b\u3089\u306a\u3044\u3088\u3046\u7406\u7531\u306e\u884c\u3054\u3068\u7701\u304f
        var reason = e.message || e.description || "";
        msgAlert("\u8d77\u52d5\u5931\u6557: " + app.name + (reason ? "\n" + reason : ""));
    }
}

// ===========================================================
// ビュー切り替え
// ===========================================================
function setView(v) {
    viewMode = v;
    updViewBtns();
    render();
}

function updViewBtns() {
    ge("btn-grid").className = "hbtn" + (viewMode === "grid" ? " active" : "");
    ge("btn-list").className = "hbtn" + (viewMode === "list" ? " active" : "");
}

// ===========================================================
// 設定パネル
// ===========================================================
function openSettings() {
    ge("s-theme").value          = cfg.settings.theme;
    ge("s-view").value           = cfg.settings.defaultView;
    ge("s-cellw").value          = String(cfg.settings.gridCellWidth || 72);
    ge("s-cols").value           = String(cfg.settings.gridCols || 5);
    ge("s-rows").value           = String(cfg.settings.gridRows || 6);
    ge("s-position").value       = cfg.settings.windowPosition || "center";
    ge("s-fontsize").value       = cfg.settings.fontSize || "small";
    ge("s-listheight").value     = String(cfg.settings.listRowHeight || 30);
    ge("s-start-tab").value      = cfg.settings.startTab || "all";
    ge("s-launch-action").value  = cfg.settings.launchAction || "minimize";
    ge("s-topmost").value        = cfg.settings.topmost ? "true" : "false";
    ge("s-cursor-trigger").value = cfg.settings.cursorTriggerEnabled ? "true" : "false";
    ge("s-cursor-position").value = cfg.settings.cursorTriggerPosition || "bottomRight";
    ge("s-auto-minimize").value  = cfg.settings.autoMinimizeOnLeave ? "true" : "false";
    ge("s-hotkey-enabled").value = cfg.settings.hotkeyEnabled ? "true" : "false";
    ge("s-hotkey-key").value     = cfg.settings.hotkey.label;
    updateHotkeyStatus();
    renderAppList();
    selIdx = -1;
    setOverlay("settings", true);
    switchTab("apps");
}

function closeSettings() {
    setOverlay("settings", false);
    renderTabs();
    render();
}

function switchTab(t) {
    ge("tab-apps").className = "stab" + (t === "apps" ? " active" : "");
    ge("tab-act").className  = "stab" + (t === "act"  ? " active" : "");
    ge("tab-look").className = "stab" + (t === "look" ? " active" : "");
    ge("st-apps").className  = "stabtn" + (t === "apps" ? " active" : "");
    ge("st-act").className   = "stabtn" + (t === "act"  ? " active" : "");
    ge("st-look").className  = "stabtn" + (t === "look" ? " active" : "");
}

// ===========================================================
// 設定: アイテムリスト
// ===========================================================
function renderAppList() {
    var tbody = ge("app-tbody");
    tbody.innerHTML = "";
    for (var i = 0; i < cfg.apps.length; i++) {
        (function (app, idx) {
            var tr = document.createElement("tr");
            if (idx === selIdx) { tr.className = "sel"; }

            var tdIcon = document.createElement("td");
            tdIcon.className = "icon-col";
            // グリッドと同じく、ここでもリモート URL は直接描画しない
            // （設定画面を開くたびに通信が走らないようにする）
            tdIcon.appendChild(makeIconEl(app, 20, "3px"));
            var td1 = document.createElement("td"); td1.textContent = app.name  || "";
            var td2 = document.createElement("td"); td2.textContent = app.group || "";
            var td3 = document.createElement("td");
            td3.textContent    = app.path || "";
            td3.style.fontSize = "11px";
            td3.style.maxWidth = "280px";
            td3.style.overflow = "hidden";
            td3.style.whiteSpace = "nowrap";

            tr.appendChild(tdIcon);
            tr.appendChild(td1);
            tr.appendChild(td2);
            tr.appendChild(td3);

            tr.onclick = (function (i) {
                return function () { selIdx = i; renderAppList(); };
            }(idx));
            tr.ondblclick = (function (i) {
                return function () { selIdx = i; dlgOpen(i); };
            }(idx));

            tbody.appendChild(tr);
        }(cfg.apps[i], i));
    }
}

function appDel() {
    if (selIdx < 0 || selIdx >= cfg.apps.length) {
        msgAlert("\u524a\u9664\u3059\u308b\u30a2\u30d7\u30ea\u3092\u9078\u629e\u3057\u3066\u304f\u3060\u3055\u3044\u3002");
        return;
    }
    var delIdx = selIdx;
    msgConfirm('"' + cfg.apps[delIdx].name + '" \u3092\u524a\u9664\u3057\u307e\u3059\u304b\uff1f', function () {
        cfg.apps.splice(delIdx, 1);
        selIdx = Math.min(delIdx, cfg.apps.length - 1);
        saveCfg();
        renderAppList();
    });
}

function appMove(dir) {
    var ni = selIdx + dir;
    if (selIdx < 0 || ni < 0 || ni >= cfg.apps.length) { return; }
    var tmp = cfg.apps[selIdx];
    cfg.apps[selIdx] = cfg.apps[ni];
    cfg.apps[ni]     = tmp;
    selIdx = ni;
    saveCfg();
    renderAppList();
}

// ===========================================================
// CLaunch.ini 取込
// ===========================================================
var claunchImportMode = "";

function claunchImportClick() {
    msgConfirm("CLaunch.ini を取り込みます。よろしいですか？", function () {
        showMsg("既存データの扱いを選択してください。\n\n"
                + "入れ替え = 今の一覧を削除して取り込む\n"
                + "追加 = 今の一覧を残して取り込む",
                [{ label: "入れ替え", value: "replace", pri: true },
                 { label: "追加",     value: "append" }],
                function (mode) {
                    claunchImportMode = mode;
                    ge("claunch-ini-picker").click();
                });
    });
}

function claunchImportLoad(input) {
    var path = input.value;
    input.value = "";
    if (!path) { return; }
    try {
        var items = parseCLaunchIni(path);
        if (claunchImportMode === "replace") {
            cfg.apps = items;
        } else {
            cfg.apps = cfg.apps.concat(items);
        }
        selIdx = -1;
        saveCfg();
        renderAppList();
        renderTabs();
        render();
        msgAlert(items.length + " 件を取り込みました。");
    } catch (e) {
        msgAlert("取込に失敗しました: " + e.message);
    }
}

function parseCLaunchIni(path) {
    var text = readUnicode(path);
    var lines = text.split(/\r?\n/);

    var pages = [];
    var currentPage = null;
    var currentItem = null;
    var pagesCount   = -1;
    var afterPages   = false;
    var inBtn        = false;

    function finishItem() {
        if (currentItem && currentPage) {
            currentPage.items.push(currentItem);
        }
        currentItem = null;
    }
    function finishPage() {
        finishItem();
        if (currentPage) { pages.push(currentPage); }
        currentPage = null;
        inBtn = false;
    }

    for (var i = 0; i < lines.length; i++) {
        var line = lines[i].replace(/^\s+|\s+$/g, "");
        if (!line) { continue; }

        if (line.charAt(0) === "[") {
            var sec = line.replace(/^\[/, "").replace(/\].*$/, "");

            if (sec === "Pages") {
                afterPages = true;
                finishPage();
                continue;
            }
            if (afterPages && /^Page\d{3}$/.test(sec)) {
                finishPage();
                if (pagesCount >= 0 && pages.length >= pagesCount) { break; }
                currentPage = { name: "", items: [] };
                inBtn = false;
                continue;
            }
            if (afterPages && currentPage && /^Btn\d{3}$/.test(sec)) {
                finishItem();
                currentItem = { name: "", file: "" };
                inBtn = true;
                continue;
            }
            // Any other section while building a page finalizes it
            if (currentPage) { finishPage(); }
            continue;
        }

        var eq = line.indexOf("=");
        if (eq < 0) { continue; }
        var key = line.substring(0, eq).replace(/^\s+|\s+$/g, "");
        var val = line.substring(eq + 1);

        if (afterPages && !currentPage && key === "Count") {
            pagesCount = parseInt(val, 10) || 0;
        } else if (inBtn && currentItem) {
            if (key === "Name") { currentItem.name = val; }
            else if (key === "File") { currentItem.file = val; }
        } else if (currentPage && !inBtn) {
            if (key === "Name") { currentPage.name = val; }
        }
    }
    finishPage();

    var apps = [];
    for (var p = 0; p < pages.length; p++) {
        var pg = pages[p];
        for (var b = 0; b < pg.items.length; b++) {
            var btn = pg.items[b];
            if (!btn.file) { continue; }
            apps.push({ name: btn.name || btn.file, path: btn.file, iconPath: "", group: pg.name });
        }
    }
    return apps;
}

function dlgOpenSel() {
    if (selIdx < 0 || selIdx >= cfg.apps.length) {
        msgAlert("\u7de8\u96c6\u3059\u308b\u30a2\u30d7\u30ea\u3092\u9078\u629e\u3057\u3066\u304f\u3060\u3055\u3044\u3002");
        return;
    }
    dlgOpen(selIdx);
}

// ===========================================================
// アイテム追加/編集ダイアログ
// ===========================================================
function dlgOpen(idx) {
    dlgIdx = idx;
    ge("dlg-title").textContent = (idx < 0)
        ? "\u30a2\u30d7\u30ea\u8ffd\u52a0"    // アイテム追加
        : "\u30a2\u30d7\u30ea\u7de8\u96c6";   // アイテム編集
    var app = (idx >= 0) ? cfg.apps[idx] : null;
    ge("d-name").value  = app ? (app.name      || "") : "";
    ge("d-path").value  = app ? (app.path      || "") : "";
    ge("d-group").value = app ? (app.group     || "") : (curTab !== "すべて" ? curTab : "");
    ge("d-icon").value  = app ? (app.iconPath  || "") : "";
    setOverlay("dlg-ov", true);
    ge("d-name").focus();
}

function dlgSave() {
    var name  = trim(ge("d-name").value);
    var path  = trim(ge("d-path").value);
    var group = trim(ge("d-group").value);
    var icon  = trim(ge("d-icon").value);

    if (!name || !path) {
        msgAlert("\u8868\u793a\u540d\u3068\u30d1\u30b9\u306f\u5fc5\u9808\u3067\u3059\u3002");
        return;
    }
    // アイコン未指定でURLの場合は iconPath を空のままにしておく。
    // 描画時に remoteIconUrl() がファビコンを導出し、取得できたら data URL として
    // 保存されるので、config にリモート URL を書き込む必要はない。
    var obj = { name: name, path: path, iconPath: icon, group: group };
    if (dlgIdx < 0) {
        cfg.apps.push(obj);
        selIdx = cfg.apps.length - 1;
    } else {
        // 編集時: tabPositions を引き継ぐ（グループ変更後の新タブは autoPos で自動割り当て）
        if (cfg.apps[dlgIdx].tabPositions) {
            obj.tabPositions = cfg.apps[dlgIdx].tabPositions;
        }
        cfg.apps[dlgIdx] = obj;
        selIdx = dlgIdx;
    }
    saveCfg();
    dlgClose();
    renderAppList();
    renderTabs();
    render();
}

function dlgClose() {
    setOverlay("dlg-ov", false);
}

function trim(s) {
    return (s || "").replace(/^\s+|\s+$/g, "");
}

// ===========================================================
// ウィンドウサイズをグリッド設定に合わせてリサイズ
// ===========================================================
function resizeToGrid() {
    var cw    = cfg.settings.gridCellWidth || 72;
    var cols  = cfg.settings.gridCols || 5;
    var rows  = cfg.settings.gridRows || 6;
    var cellH = cw + lblH;   // アイコン高さ + ラベル領域
    // ウィンドウ装飾サイズを実測（タイトルバー・ボーダー込み）
    var decoW = Math.max(window.outerWidth  - document.documentElement.clientWidth,  16);
    var decoH = Math.max(window.outerHeight - document.documentElement.clientHeight, 50);
    var targetW = cols * (cw + 4) + 16 + decoW;   // セル×列 + 余白 + 装飾
    var targetH = rows * (cellH + 4) + 16 + 44 + 34 + decoH; // セル×行 + ヘッダー + タブ + 装飾
    try { window.resizeTo(Math.max(targetW, 280), Math.max(targetH, 200)); } catch (e) {}
}

function positionToWindow() {
    var pos = cfg.settings.windowPosition || "center";
    var screenW = screen.availWidth;
    var screenH = screen.availHeight;
    var winW = window.outerWidth;
    var winH = window.outerHeight;
    var x, y;
    if (pos === "topLeft") {
        x = 0; y = 0;
    } else if (pos === "topRight") {
        x = screenW - winW; y = 0;
    } else if (pos === "bottomLeft") {
        x = 0; y = screenH - winH;
    } else if (pos === "bottomRight") {
        x = screenW - winW; y = screenH - winH;
    } else { // center
        x = (screenW - winW) / 2; y = (screenH - winH) / 2;
    }
    try { window.moveTo(x, y); } catch (e) {}
}

// ===========================================================
// PowerShell 連携
// Win32 API を叩く必要のある処理（最前面化・カーソル位置トリガー・
// ショートカットキー）は PowerShell に任せるが、スクリプトは配布物として
// 別ファイルにはせず、このファイル末尾の <script type="text/powershell"> に
// 原文のまま置く。HTALauncher.hta 単体で完結させるため。
// ===========================================================

// PowerShell のシングルクォート文字列に埋め込むためのエスケープ
function psq(s) { return String(s).replace(/'/g, "''"); }

// 埋め込みスクリプトを取り出し、プレースホルダを差し替えて非表示起動する。
// 置換は split/join で行う（RegExp だと置換値の $ や \ が特別扱いされるため）。
//
// スクリプトは %TEMP% に書き出して -File で渡す。-EncodedCommand だと
// コマンドライン全体が 32767 文字の上限に掛かるため（Base64 は UTF-16 の
// バイト列を符号化するので、元のスクリプトの約 2.7 倍に膨らむ）。
// スクリプト ID ごとに固定の名前を使うので、ファイルが増え続けることはない。
// HTA 自体は 1 ファイルのままで、この .ps1 は実行のたびに作り直される。
function runPs(scriptId, vars) {
    var src = document.getElementById(scriptId).text;
    for (var k in vars) { src = src.split(k).join(vars[k]); }
    var path = TMPDIR + "\\HTALauncher_" + scriptId + ".ps1";
    // BOM 付き UTF-8 で書く。BOM が無いと PowerShell 5.1 は
    // システムの ANSI コードページとみなし、日本語コメントが化ける
    writeUtf8(path, src);
    wsh.Run('powershell -NoProfile -NoLogo -ExecutionPolicy Bypass -WindowStyle Hidden -File "' + path + '"', 0, false);
}

// ===========================================================
// 最前面表示
// "HTML Application Host Window Class" で自分の窓を特定し SetWindowPos する。
// HTA:APPLICATION の ALWAYSONTOP 属性は実行時に変更できないため使わない
// （属性を付けると「しない」を選んでも解除できない）。
// ===========================================================
function applyTopmost(on) {
    runPs("ps-topmost", { "__TOPMOST__": on ? "$true" : "$false" });
}

// ===========================================================
// 最小化状態からの復帰
// 「アイテム選択後の動作 = 最小化する」で起動に失敗したときに使う。
// 自前のモーダルは窓の中に描くので、最小化したままでは見えないため。
// wsh.AppActivate では最小化された窓は元に戻せない（フォーカスが移るだけ）
// ので、ここも PowerShell から ShowWindow(SW_RESTORE) を呼ぶ。
// ===========================================================
function restoreWindow() {
    try { runPs("ps-restore", {}); } catch (e) {}
}

// ===========================================================
// カーソル監視の常駐プロセス
// PowerShell を 1 本立ち上げ、GetCursorPos でカーソル位置を監視させる。
// 「カーソル位置で起動」と「カーソルが外れたら最小化」の両方をこれ 1 本が担う
// （どちらか一方でも ON なら常駐し、両方 OFF になったら自分で終了する）。
// トリガー用の極小ウィンドウを画面端に置く方式と違い、他の窓に遮蔽されて
// 反応しなくなることがない。多重起動は常駐側の名前付き Mutex が防ぐ。
// ===========================================================
function startWatcher() {
    runPs("ps-cursor-watcher", {
        "__CFGPATH__": psq(CFGPATH),
        "__HTAPATH__": psq(SELFPATH),
        "__HKSTATPATH__": psq(HKSTATPATH),
        "__MODALPATH__": psq(MODALFLAGPATH)
    });
}

// ===========================================================
// ホットキー登録状況の表示
// 常駐 PowerShell は UI を持たないため、RegisterHotKey の成否を
// %TEMP% の 1 行ファイルに書いてもらい、設定画面でそれを読んで知らせる。
// 他アプリと組み合わせが衝突すると「押しても無反応」になるが、
// 理由が分からないと直しようがないため。
// ===========================================================
var hkStatTimer = null;

function updateHotkeyStatus() {
    var el = ge("s-hotkey-msg");
    if (!el) { return; }
    var stat = "";
    try {
        if (fso.FileExists(HKSTATPATH)) { stat = trim(readUtf8(HKSTATPATH)); }
    } catch (e) {}

    if (!cfg.settings.hotkeyEnabled) {
        el.className = "shint";
        el.innerHTML = "";
    } else if (stat === "conflict") {
        el.className = "shint err";
        el.innerHTML = "他のアプリが使用中のため登録できませんでした。別のキーを試してください。";
    } else if (stat === "ok") {
        el.className = "shint";
        el.innerHTML = "有効です。";
    } else {
        el.className = "shint";
        el.innerHTML = "";
    }
}

// 常駐側は config.json を最大 1 秒周期で読み直すので、
// 設定を変えた直後ではなく、反映を待ってから状況を読む。
function scheduleHotkeyStatus() {
    var el = ge("s-hotkey-msg");
    if (el && cfg.settings.hotkeyEnabled) {
        el.className = "shint";
        el.innerHTML = "登録中…";
    }
    if (hkStatTimer) { window.clearTimeout(hkStatTimer); }
    hkStatTimer = window.setTimeout(function () {
        hkStatTimer = null;
        updateHotkeyStatus();
    }, 1500);
}

</script>

<!--
  以下は PowerShell のソース。type が未知のため IE は実行せず、
  JScript から .text で原文のまま取り出せる（エスケープ不要）。
-->
<script type="text/powershell" id="ps-topmost">
$title = 'HTALauncher'
$topmost = __TOPMOST__

Add-Type -TypeDefinition @'
using System;
using System.Runtime.InteropServices;
public class HtaTopmost {
    [DllImport("user32.dll", SetLastError = true)]
    public static extern IntPtr FindWindow(string lpClassName, string lpWindowName);
    [DllImport("user32.dll", SetLastError = true)]
    public static extern bool SetWindowPos(IntPtr hWnd, IntPtr hWndInsertAfter, int X, int Y, int cx, int cy, uint uFlags);
}
'@

$HWND_TOPMOST   = [IntPtr](-1)
$HWND_NOTOPMOST = [IntPtr](-2)
$SWP_NOSIZE = 0x0001
$SWP_NOMOVE = 0x0002

# 起動直後に呼ばれた場合はまだ窓が存在しないことがあるためリトライする
$hwnd = [IntPtr]::Zero
for ($i = 0; $i -lt 50; $i++) {
    $hwnd = [HtaTopmost]::FindWindow('HTML Application Host Window Class', $title)
    if ($hwnd -ne [IntPtr]::Zero) { break }
    Start-Sleep -Milliseconds 100
}

if ($hwnd -ne [IntPtr]::Zero) {
    $insertAfter = if ($topmost) { $HWND_TOPMOST } else { $HWND_NOTOPMOST }
    [HtaTopmost]::SetWindowPos($hwnd, $insertAfter, 0, 0, 0, 0, $SWP_NOMOVE -bor $SWP_NOSIZE) | Out-Null
}
</script>

<script type="text/powershell" id="ps-restore">
$title = 'HTALauncher'

Add-Type -TypeDefinition @'
using System;
using System.Runtime.InteropServices;
public class HtaRestore {
    [DllImport("user32.dll", SetLastError = true)]
    public static extern IntPtr FindWindow(string lpClassName, string lpWindowName);
    [DllImport("user32.dll")]
    public static extern bool ShowWindow(IntPtr hWnd, int nCmdShow);
    [DllImport("user32.dll")]
    public static extern bool SetForegroundWindow(IntPtr hWnd);
    [DllImport("user32.dll")]
    public static extern IntPtr GetForegroundWindow();
    [DllImport("user32.dll")]
    public static extern uint GetWindowThreadProcessId(IntPtr hWnd, out uint lpdwProcessId);
    [DllImport("kernel32.dll")]
    public static extern uint GetCurrentThreadId();
    [DllImport("user32.dll")]
    public static extern bool AttachThreadInput(uint idAttach, uint idAttachTo, bool fAttach);
}
'@

$SW_RESTORE = 9

$hwnd = [HtaRestore]::FindWindow('HTML Application Host Window Class', $title)
if ($hwnd -ne [IntPtr]::Zero) {
    # 常駐ウォッチャーの Invoke-Activate と同じ理由で、フォアグラウンド
    # スレッドの入力キューに一時的に接続してから前面化する
    $fgProcId = 0
    $fgThreadId = [HtaRestore]::GetWindowThreadProcessId([HtaRestore]::GetForegroundWindow(), [ref]$fgProcId)
    $curThreadId = [HtaRestore]::GetCurrentThreadId()

    $attached = $false
    if ($fgThreadId -ne 0 -and $fgThreadId -ne $curThreadId) {
        $attached = [HtaRestore]::AttachThreadInput($curThreadId, $fgThreadId, $true)
    }
    try {
        [HtaRestore]::ShowWindow($hwnd, $SW_RESTORE) | Out-Null
        [HtaRestore]::SetForegroundWindow($hwnd) | Out-Null
    } finally {
        if ($attached) {
            [HtaRestore]::AttachThreadInput($curThreadId, $fgThreadId, $false) | Out-Null
        }
    }
}
</script>

<script type="text/powershell" id="ps-cursor-watcher">
$cfgPath  = '__CFGPATH__'
$htaPath  = '__HTAPATH__'
$hkStatPath = '__HKSTATPATH__'
$modalPath  = '__MODALPATH__'
$title    = 'HTALauncher'

# 多重起動防止。HTALauncher を再起動しても、設定を ON/OFF し直しても
# 常駐は 1 本に保たれる（ロックファイルと違い後始末も不要）。
$created = $false
$mutex = New-Object System.Threading.Mutex($true, 'Local\HTALauncherCursorWatcher', [ref]$created)
if (-not $created) { exit 0 }

Add-Type -TypeDefinition @'
using System;
using System.Runtime.InteropServices;
public class HtaWin {
    [StructLayout(LayoutKind.Sequential)] public struct POINT { public int X; public int Y; }
    [StructLayout(LayoutKind.Sequential)] public struct RECT { public int Left; public int Top; public int Right; public int Bottom; }

    [DllImport("user32.dll")]
    public static extern bool GetCursorPos(out POINT lpPoint);
    [DllImport("user32.dll")]
    public static extern bool SystemParametersInfo(uint uiAction, uint uiParam, out RECT pvParam, uint fWinIni);
    [DllImport("user32.dll", SetLastError = true)]
    public static extern IntPtr FindWindow(string lpClassName, string lpWindowName);
    [DllImport("user32.dll")]
    public static extern bool ShowWindow(IntPtr hWnd, int nCmdShow);
    [DllImport("user32.dll")]
    public static extern bool GetWindowRect(IntPtr hWnd, out RECT lpRect);
    [DllImport("user32.dll")]
    public static extern bool IsIconic(IntPtr hWnd);
    [DllImport("user32.dll")]
    public static extern bool SetForegroundWindow(IntPtr hWnd);
    [DllImport("user32.dll")]
    public static extern IntPtr GetForegroundWindow();
    [DllImport("user32.dll")]
    public static extern uint GetWindowThreadProcessId(IntPtr hWnd, out uint lpdwProcessId);
    [DllImport("kernel32.dll")]
    public static extern uint GetCurrentThreadId();
    [DllImport("user32.dll")]
    public static extern bool AttachThreadInput(uint idAttach, uint idAttachTo, bool fAttach);

    [StructLayout(LayoutKind.Sequential)]
    public struct MSG {
        public IntPtr hwnd; public uint message; public IntPtr wParam; public IntPtr lParam;
        public uint time; public int ptX; public int ptY;
    }
    [DllImport("user32.dll", SetLastError = true)]
    public static extern bool RegisterHotKey(IntPtr hWnd, int id, uint fsModifiers, uint vk);
    [DllImport("user32.dll", SetLastError = true)]
    public static extern bool UnregisterHotKey(IntPtr hWnd, int id);
    [DllImport("user32.dll")]
    public static extern bool PeekMessage(out MSG lpMsg, IntPtr hWnd, uint wMsgFilterMin, uint wMsgFilterMax, uint wRemoveMsg);
}
'@

$SW_RESTORE = 9
$SW_MINIMIZE = 6
$SPI_GETWORKAREA = 0x0030
$THICKNESS = 4

$MOD_ALT      = 0x0001
$MOD_CONTROL  = 0x0002
$MOD_SHIFT    = 0x0004
# 押しっぱなしのオートリピートを OS 側で抑止する（Windows 7 以降）
$MOD_NOREPEAT = 0x4000
$WM_HOTKEY    = 0x0312
$PM_REMOVE    = 0x0001
$HOTKEY_ID    = 1
# ウィンドウから出てすぐに最小化すると、端をかすめただけで消えて使いにくい。
# この時間だけ外に居続けたら最小化する。
$LEAVE_DWELL_MS = 400

# トリガー領域を作業領域（タスクバーを除いた範囲）から求める。
# 解像度やタスクバーの変更に追従できるよう毎回計算し直す。
function Get-TriggerZone($pos) {
    $wa = New-Object 'HtaWin+RECT'
    if (-not [HtaWin]::SystemParametersInfo($SPI_GETWORKAREA, 0, [ref]$wa, 0)) { return $null }
    $x0 = $wa.Left
    $y0 = $wa.Top
    $sw = $wa.Right - $wa.Left
    $sh = $wa.Bottom - $wa.Top
    $t  = $THICKNESS
    # 各要素は必ず括弧で括る。PowerShell では , が - より優先度が高いため、
    # @($x0 + $sw - $t, $y0, ...) は「$sw から配列を引く」と解釈されてしまう。
    $r = ($x0 + $sw - $t)  # 右端に寄せた x
    $b = ($y0 + $sh - $t)  # 下端に寄せた y
    switch ($pos) {
        'topLeft'     { return @($x0, $y0, $t,  $t)  }
        'topRight'    { return @($r,  $y0, $t,  $t)  }
        'bottomLeft'  { return @($x0, $b,  $t,  $t)  }
        'bottomRight' { return @($r,  $b,  $t,  $t)  }
        'top'         { return @($x0, $y0, $sw, $t)  }
        'bottom'      { return @($x0, $b,  $sw, $t)  }
        'left'        { return @($x0, $y0, $t,  $sh) }
        'right'       { return @($r,  $y0, $t,  $sh) }
        default       { return @($r,  $b,  $t,  $t)  }
    }
}

# マウスのホバーはクリックと違い OS のフォアグラウンド権限を伴わないため、
# 単純な ShowWindow/SetForegroundWindow は Windows のフォアグラウンドロックで
# 無視される。現在のフォアグラウンドスレッドの入力キューに自スレッドを一時的に
# 接続してから操作することでこれを回避する（AutoHotkey 等でも使われる正規の手段）。
function Invoke-Activate {
    $hwnd = [HtaWin]::FindWindow('HTML Application Host Window Class', $title)
    if ($hwnd -ne [IntPtr]::Zero) {
        $fgWnd = [HtaWin]::GetForegroundWindow()
        $fgProcId = 0
        $fgThreadId = [HtaWin]::GetWindowThreadProcessId($fgWnd, [ref]$fgProcId)
        $curThreadId = [HtaWin]::GetCurrentThreadId()

        $attached = $false
        if ($fgThreadId -ne 0 -and $fgThreadId -ne $curThreadId) {
            $attached = [HtaWin]::AttachThreadInput($curThreadId, $fgThreadId, $true)
        }
        try {
            [HtaWin]::ShowWindow($hwnd, $SW_RESTORE) | Out-Null
            [HtaWin]::SetForegroundWindow($hwnd) | Out-Null
        } finally {
            if ($attached) {
                [HtaWin]::AttachThreadInput($curThreadId, $fgThreadId, $false) | Out-Null
            }
        }
    } elseif ($htaPath -ne '') {
        Start-Process 'mshta.exe' -ArgumentList ('"' + $htaPath + '"')
    }
}

# グローバルホットキーの登録し直し。
# hWnd に IntPtr::Zero を渡すと WM_HOTKEY は「登録したスレッド」のメッセージ
# キューに届く。このスクリプトは終始同じスレッドで回っているので問題ない。
# 登録の成否は HTALauncher 側からは分からないため、ステータスファイルで返す
# （衝突すると「押しても無反応」になり、理由が分からないと直せないため）。
function Set-Hotkey($on, $hk) {
    if ($script:hkRegistered) {
        [HtaWin]::UnregisterHotKey([IntPtr]::Zero, $HOTKEY_ID) | Out-Null
        $script:hkRegistered = $false
    }

    $status = 'off'
    if ($on -and $hk -ne $null -and $hk.vk) {
        $mods = $MOD_NOREPEAT
        if ($hk.ctrl)  { $mods = $mods -bor $MOD_CONTROL }
        if ($hk.alt)   { $mods = $mods -bor $MOD_ALT }
        if ($hk.shift) { $mods = $mods -bor $MOD_SHIFT }
        if ([HtaWin]::RegisterHotKey([IntPtr]::Zero, $HOTKEY_ID, [uint32]$mods, [uint32]$hk.vk)) {
            $script:hkRegistered = $true
            $status = 'ok'
        } else {
            # 他のアプリが同じ組み合わせを先に握っている
            $status = 'conflict'
        }
    }
    try { [IO.File]::WriteAllText($hkStatPath, $status, [Text.Encoding]::UTF8) } catch {}
}

# ホットキーはトグル動作にする。
# 前面にいるときにもう一度押したら引っ込む、という一般的なランチャーの挙動。
function Invoke-Toggle {
    $hwnd = [HtaWin]::FindWindow('HTML Application Host Window Class', $title)
    if ($hwnd -eq [IntPtr]::Zero) {
        if ($htaPath -ne '') { Start-Process 'mshta.exe' -ArgumentList ('"' + $htaPath + '"') }
        return
    }
    if (-not [HtaWin]::IsIconic($hwnd) -and [HtaWin]::GetForegroundWindow() -eq $hwnd) {
        [HtaWin]::ShowWindow($hwnd, $SW_MINIMIZE) | Out-Null
    } else {
        Invoke-Activate
    }
}

# カーソルがウィンドウから外れたら最小化する。
# 判定にはクライアント領域ではなくウィンドウ矩形（タイトルバー・枠を含む）を使う。
# HTA 側の mouseleave だと、閉じるボタンに手を伸ばした瞬間やタイトルバーを
# 掴んだ瞬間に「外に出た」と判定されてしまうため。
function Update-AutoMinimize($p, $ms) {
    $hwnd = [HtaWin]::FindWindow('HTML Application Host Window Class', $title)
    if ($hwnd -eq [IntPtr]::Zero -or [HtaWin]::IsIconic($hwnd)) {
        # 未起動 or 最小化中。次に復帰したとき、カーソルが窓の外にあっても
        # すぐ最小化し直さないように武装解除しておく
        $script:armed = $false
        $script:leftAt = 0
        return
    }

    # フォルダ参照やファイル選択などのダイアログは自分のウィンドウ矩形の外に出る。
    # 同じプロセスの別ウィンドウが前面にある間は最小化しない。
    $fg = [HtaWin]::GetForegroundWindow()
    if ($fg -ne [IntPtr]::Zero -and $fg -ne $hwnd) {
        $fgPid = 0; [HtaWin]::GetWindowThreadProcessId($fg, [ref]$fgPid) | Out-Null
        $myPid = 0; [HtaWin]::GetWindowThreadProcessId($hwnd, [ref]$myPid) | Out-Null
        if ($fgPid -ne 0 -and $fgPid -eq $myPid) { $script:leftAt = 0; return }
    }

    $r = New-Object 'HtaWin+RECT'
    if (-not [HtaWin]::GetWindowRect($hwnd, [ref]$r)) { return }
    $inWin = ($p.X -ge $r.Left) -and ($p.X -lt $r.Right) -and
             ($p.Y -ge $r.Top)  -and ($p.Y -lt $r.Bottom)

    if ($inWin) {
        # 一度ウィンドウ内に入って初めて武装する。
        # 起動直後や復帰直後にカーソルが画面外・窓外にあっても即最小化しないため。
        $script:armed = $true
        $script:leftAt = 0
        return
    }

    if (-not $script:armed) { return }
    if ($script:leftAt -eq 0) { $script:leftAt = $ms; return }
    if (($ms - $script:leftAt) -ge $LEAVE_DWELL_MS) {
        # 追加/編集ダイアログや設定を開いている間は最小化しない。
        # これらは HTA の中に描かれるので別ウィンドウとして判別できず、
        # 参照ボタンやファイル選択で枠の外を操作すると消えてしまうため。
        # 実際に最小化する直前だけ見に行けば、常駐中のファイル確認は最小限で済む。
        if ([IO.File]::Exists($modalPath)) { $script:leftAt = 0; return }
        [HtaWin]::ShowWindow($hwnd, $SW_MINIMIZE) | Out-Null
        $script:armed = $false
        $script:leftAt = 0
    }
}

$pos  = $null
$zone = $null
$triggerOn = $false
$autoMinOn = $false
$hotkeyOn  = $false
$hkRegistered = $false
$hkSig     = 'off'       # 登録済みホットキーの設定署名（変化時だけ登録し直す）
$armed     = $false      # 一度ウィンドウ内にカーソルが入ったか
$leftAt    = [int64]0    # ウィンドウ外に出た時刻（0 = 外に出ていない）
$lastCfgCheck = [int64](-10000)
$lastFire     = [int64](-10000)
$lastWrite    = [DateTime]::MinValue
# 起動直後にカーソルがゾーン内にあってもいきなり発火しないよう内側扱いから始める
$wasInside = $true

# 常駐し続けるループなので、1周あたりのコストを抑える:
#  - 時刻は Get-Date（コマンドレット呼び出し）ではなく Stopwatch のカウンタで見る
#  - 待機は Start-Sleep ではなく Thread::Sleep
#  - POINT は毎回 New-Object せず使い回す
#  - config.json は更新時刻が変わったときだけ読み直す（毎秒 ConvertFrom-Json
#    すると、それだけで常駐プロセスの CPU の大半を占めてしまう）
$clock = [Diagnostics.Stopwatch]::StartNew()
$pt = New-Object 'HtaWin+POINT'
$msg = New-Object 'HtaWin+MSG'

# RegisterHotKey より先にメッセージキューを確実に作っておく
[HtaWin]::PeekMessage([ref]$msg, [IntPtr]::Zero, 0, 0, $PM_REMOVE) | Out-Null

try {
    while ($true) {
        $ms = $clock.ElapsedMilliseconds

        if (($ms - $lastCfgCheck) -ge 1000) {
            $lastCfgCheck = $ms
            if (-not [IO.File]::Exists($cfgPath)) { break }
            $stamp = [IO.File]::GetLastWriteTimeUtc($cfgPath)
            if ($stamp -ne $lastWrite) {
                $cfg = $null
                try { $cfg = Get-Content -LiteralPath $cfgPath -Raw -Encoding UTF8 | ConvertFrom-Json } catch { $cfg = $null }
                # 読み込み失敗は HTALauncher 側の書き込みとの競合の可能性があるため、
                # 無効化されたとはみなさず設定を据え置き、次回もう一度試す
                if ($cfg -ne $null) {
                    $lastWrite = $stamp
                    if (-not $cfg.settings) { break }
                    $triggerOn = [bool]$cfg.settings.cursorTriggerEnabled
                    $autoMinOn = [bool]$cfg.settings.autoMinimizeOnLeave
                    $hotkeyOn  = [bool]$cfg.settings.hotkeyEnabled
                    # すべて OFF になったら常駐している意味がないので終了する
                    if (-not $triggerOn -and -not $autoMinOn -and -not $hotkeyOn) { break }
                    $newPos = $cfg.settings.cursorTriggerPosition
                    if ($newPos -ne $pos) {
                        $pos = $newPos
                        $wasInside = $true
                    }
                    # 毎秒 RegisterHotKey をやり直さないよう、設定が変わったときだけ登録する
                    $hk = $cfg.settings.hotkey
                    $newSig = 'off'
                    if ($hotkeyOn -and $hk -ne $null) {
                        $newSig = '{0}|{1}|{2}|{3}' -f [bool]$hk.ctrl, [bool]$hk.alt, [bool]$hk.shift, $hk.vk
                    }
                    if ($newSig -ne $hkSig) {
                        $hkSig = $newSig
                        Set-Hotkey $hotkeyOn $hk
                    }
                }
            }
            # 領域の計算そのものは安価なので、解像度やタスクバーの変更に
            # 追従できるよう設定が変わっていなくても毎回やり直す
            if ($pos -ne $null) { $zone = Get-TriggerZone $pos }
        }

        if ([HtaWin]::GetCursorPos([ref]$pt)) {
            # カーソル位置トリガー（最小化からの復帰・未起動なら新規起動）
            if ($triggerOn -and $zone -ne $null) {
                $inside = ($pt.X -ge $zone[0]) -and ($pt.X -lt ($zone[0] + $zone[2])) -and
                          ($pt.Y -ge $zone[1]) -and ($pt.Y -lt ($zone[1] + $zone[3]))
                # 外→内に入った瞬間だけ発火させる（滞在中の連射防止）
                if ($inside -and -not $wasInside -and ($ms - $lastFire) -ge 1500) {
                    $lastFire = $ms
                    Invoke-Activate
                }
                $wasInside = $inside
            }

            # カーソルが外れたら最小化
            if ($autoMinOn) { Update-AutoMinimize $pt $ms }
        }

        # ショートカットキー。ブロックする GetMessage ではなく PeekMessage を使うのは、
        # カーソル監視の 50ms ポーリングを止めないため（反応の遅れは最大 50ms）。
        if ($hkRegistered) {
            while ([HtaWin]::PeekMessage([ref]$msg, [IntPtr]::Zero, 0, 0, $PM_REMOVE)) {
                if ($msg.message -eq $WM_HOTKEY) { Invoke-Toggle }
            }
        }

        [System.Threading.Thread]::Sleep(50)
    }
} finally {
    if ($hkRegistered) {
        [HtaWin]::UnregisterHotKey([IntPtr]::Zero, $HOTKEY_ID) | Out-Null
    }
    try { [IO.File]::WriteAllText($hkStatPath, 'off', [Text.Encoding]::UTF8) } catch {}
    $mutex.ReleaseMutex()
    $mutex.Dispose()
}
</script>
</body>
</html>
