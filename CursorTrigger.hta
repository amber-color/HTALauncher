<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
<title>HTALauncherCursorTrigger</title>
<!--
IE=Edge (X-UA-Compatible) を指定すると、HTALauncher.hta（本体）が同時に
起動している状態で window.resizeTo/moveTo が例外も出さず無視される現象が
確認されたため、このファイルではあえて指定していない。
-->
<HTA:APPLICATION
    ID="oTrigger"
    APPLICATIONNAME="HTALauncherCursorTrigger"
    BORDER="none"
    BORDERSTYLE="none"
    CAPTION="no"
    MAXIMIZEBUTTON="no"
    MINIMIZEBUTTON="no"
    SCROLL="no"
    SELECTION="no"
    SHOWINTASKBAR="no"
    SINGLEINSTANCE="yes"
    SYSMENU="no"
    VERSION="1.0"
    WINDOWSTATE="normal"
    NAVIGABLE="no"
    CONTEXTMENU="no"
    INNERBORDER="no"
/>
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { width: 100%; height: 100%; overflow: hidden; background: #010101; }
</style>
</head>
<body>
<script language="VBScript">
' HTALauncher.hta（本体）が同時に起動していると、JScript 側からの
' window.resizeTo/moveTo は例外も出さず無視されることが判明した。
' VBScript から呼ぶと同じ window オブジェクトに対してでも問題なく効くため、
' 位置・サイズの変更は必ずこの関数を経由する。
Sub Window_OnLoad
    InitTrigger
End Sub

Sub RepositionVB(x, y, w, h)
    window.resizeTo w, h
    window.moveTo x, y
End Sub
</script>
<script language="JScript">
// ===========================================================
// ファイル I/O（HTALauncher.hta と同様、ADODB.Stream で UTF-8 対応）
// ===========================================================
var fso = new ActiveXObject("Scripting.FileSystemObject");
var wsh = new ActiveXObject("WScript.Shell");

function getDir() {
    var p = location.pathname.replace(/\//g, "\\");
    if (p.charAt(0) === "\\") { p = p.substring(1); }
    return fso.GetParentFolderName(p);
}
var DIR     = getDir();
var CFGPATH = DIR + "\\config.json";
var MAINHTA = DIR + "\\HTALauncher.hta";
var TRIGGER_FLAG = DIR + "\\.activate_trigger";

function readUtf8(path) {
    var st = new ActiveXObject("ADODB.Stream");
    st.Type    = 2;
    st.Charset = "UTF-8";
    st.Open();
    st.LoadFromFile(path);
    var s = st.ReadText();
    st.Close();
    if (s && s.charCodeAt(0) === 0xFEFF) { s = s.substring(1); }
    return s;
}

// IE=Edge を指定していないため、この文書モードでは組み込みの JSON
// オブジェクトが存在しない。信頼できる自前生成の JSON なので eval で代替する。
function parseJson(raw) {
    if (typeof JSON !== "undefined" && JSON.parse) { return JSON.parse(raw); }
    return eval("(" + raw + ")");
}

function readCfg() {
    try { return parseJson(readUtf8(CFGPATH)); } catch (e) { return null; }
}

// ===========================================================
// トリガー位置に合わせてウィンドウを配置
// VBScript 経由の resizeTo/moveTo はクランプされず要求通りのサイズに
// なることを確認済みのため、角は TH px 四方、辺は画面幅/高さ×TH px の
// 帯として、常に画面内に収まる形でそのまま配置する。
function applyZone() {
    var pos = "bottomRight";
    var c = readCfg();
    if (c && c.settings && c.settings.cursorTriggerPosition) {
        pos = c.settings.cursorTriggerPosition;
    }

    var sw = screen.availWidth, sh = screen.availHeight;
    var TH = 4; // トリガー領域の太さ(px)
    var w, h, x, y;
    switch (pos) {
        case "topLeft":     w = TH; h = TH; x = 0;      y = 0;      break;
        case "topRight":    w = TH; h = TH; x = sw - TH; y = 0;      break;
        case "bottomLeft":  w = TH; h = TH; x = 0;      y = sh - TH; break;
        case "bottomRight": w = TH; h = TH; x = sw - TH; y = sh - TH; break;
        case "top":         w = sw; h = TH; x = 0;      y = 0;      break;
        case "bottom":      w = sw; h = TH; x = 0;      y = sh - TH; break;
        case "left":        w = TH; h = sh; x = 0;      y = 0;      break;
        case "right":       w = TH; h = sh; x = sw - TH; y = 0;      break;
        default:            w = TH; h = TH; x = sw - TH; y = sh - TH;
    }
    RepositionVB(x, y, w, h);
}

// ===========================================================
// 多重起動チェック（SINGLEINSTANCE 属性は別プロセスからの起動を
// 防いでくれないため、EnumWindows で同名ウィンドウの数を数える）
// ===========================================================
function isDuplicateInstance() {
    var ps1Path = DIR + "\\CursorTriggerGuard.ps1";
    var rc = wsh.Run('powershell -NoProfile -NoLogo -WindowStyle Hidden -ExecutionPolicy Bypass -File "' + ps1Path + '"', 0, true);
    return rc === 1;
}

// ===========================================================
// 最前面表示（HTALauncher.hta の applyTopmost() と同じ仕組みを流用）
// ===========================================================
function applyTopmost() {
    var ps1Path = DIR + "\\TopMost.ps1";
    wsh.Run('powershell -NoProfile -NoLogo -WindowStyle Hidden -ExecutionPolicy Bypass -File "' + ps1Path + '" -title "HTALauncherCursorTrigger"', 0, false);
}

// ===========================================================
// HTALauncher 本体をアクティブ化（未起動なら起動）
// マウスの hover はクリックと違い OS のフォアグラウンド権限を伴わないため、
// 単純な ShowWindow/SetForegroundWindow（同一プロセス内で呼んでも）は
// Windows のフォアグラウンドロックで無視される。ActivateWatcher.ps1 が
// AttachThreadInput で現在のフォアグラウンドスレッドに一時的に接続してから
// 操作することでこれを回避する（AutoHotkey 等でも使われる正規の手段）。
//
// ホバーのたびに powershell.exe を新規起動すると、プロセス起動だけで
// 約0.9秒かかり復帰が遅く感じるため、常駐させた ActivateWatcher.ps1 に
// 軽量なシグナルファイルを書き込むだけにして高速化する。
// ===========================================================
function startActivateWatcher() {
    var ps1Path = DIR + "\\ActivateWatcher.ps1";
    wsh.Run('powershell -NoProfile -NoLogo -WindowStyle Hidden -ExecutionPolicy Bypass -File "' + ps1Path +
            '" -triggerFlagPath "' + TRIGGER_FLAG + '" -htaPath "' + MAINHTA + '"', 0, false);
}

var lastTrigger = 0;
function activateOrLaunch() {
    var now = new Date().getTime();
    if (now - lastTrigger < 1500) { return; } // 連続発火防止
    lastTrigger = now;
    try {
        var f = fso.CreateTextFile(TRIGGER_FLAG, true);
        f.Close();
    } catch (e) {}
}

document.body.onmouseover = function () { activateOrLaunch(); };

var lastPos = null;
function InitTrigger() {
    try { if (isDuplicateInstance()) { window.close(); return; } } catch (eDup) {}

    try {
        applyZone();
        var c0 = readCfg();
        lastPos = c0 && c0.settings && c0.settings.cursorTriggerPosition;
    } catch (eZone) {}
    try { applyTopmost(); } catch (eTop) {}
    try { startActivateWatcher(); } catch (eWatch) {}

    // 設定を毎秒ポーリング：無効化されたら自己終了、位置設定が変わったら追従
    // config.json はもう一方の HTALauncher.hta も書き込むため、読み込みに
    // 失敗した場合（書き込み中の競合等）は無効化されたとみなさず何もしない
    setInterval(function () {
        var c = readCfg();
        if (c === null) { return; }
        if (!c.settings || !c.settings.cursorTriggerEnabled) {
            window.close();
            return;
        }
        if (c.settings.cursorTriggerPosition !== lastPos) {
            lastPos = c.settings.cursorTriggerPosition;
            try { applyZone(); } catch (eZone2) {}
        }
    }, 1000);
}
</script>
</body>
</html>
